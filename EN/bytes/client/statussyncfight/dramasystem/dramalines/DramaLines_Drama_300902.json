[
    {
        "TextId": 30090201,
        "ActorName": "Bianca",
        "ActorTalk": "The view here is lovely.",
        "Cv": 510021006.0,
        "Desc": null
    },
    {
        "TextId": 30090202,
        "ActorName": "Bianca",
        "ActorTalk": "You can see the quiet everyday life below, and clouds above that look like a field of snow.",
        "Cv": 510021007.0,
        "Desc": null
    },
    {
        "TextId": 30090203,
        "ActorName": "[PlayerName]",
        "ActorTalk": "And I can see a relaxed, happy Bianca right here.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30090204,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Gaze quietly at Bianca)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30090205,
        "ActorName": "Bianca",
        "ActorTalk": "What's that line again?",
        "Cv": 510021008.0,
        "Desc": null
    },
    {
        "TextId": 30090206,
        "ActorName": "Bianca",
        "ActorTalk": "\"I like to feel your eyes on me when I look away.\"",
        "Cv": 510021009.0,
        "Desc": null
    },
    {
        "TextId": 30090207,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Looks like movie lines really do come from real life.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30090208,
        "ActorName": "Bianca",
        "ActorTalk": "Commandant... why are you staring at me like that?",
        "Cv": 510021010.0,
        "Desc": null
    },
    {
        "TextId": 30090209,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\"I like to feel your eyes on me when I look away.\"",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30090210,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Movie lines are often inspired by moments like this.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30090211,
        "ActorName": "Bianca",
        "ActorTalk": "This peaceful life... I hope it lasts for a long, long time.",
        "Cv": 510021011.0,
        "Desc": null
    },
    {
        "TextId": 30090212,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\"As long as stars are above you.\"",
        "Cv": null,
        "Desc": null
    }
]