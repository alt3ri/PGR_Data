[
    {
        "TextId": 1,
        "ActorName": "Asimov",
        "ActorTalk": "You look surprised.",
        "Cv": 510025008.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "It's not quiet here. Doesn't feel like somewhere you'd enjoy.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Asimov",
        "ActorTalk": "Perfect spot when you can't mute your alert notifications.",
        "Cv": 510025009.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Asimov",
        "ActorTalk": "Even constant alerts don't feel out of place here, right?",
        "Cv": 510025010.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Uh... your alerts haven't stopped. Aren't you checking them?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Asimov",
        "ActorTalk": "Ah, that...",
        "Cv": 510025011.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Asimov",
        "ActorTalk": "Just Parliament arguing again. I stay out of it.",
        "Cv": 510025012.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Those alerts... nothing serious, right?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Asimov",
        "ActorTalk": "It's a report from the new researchers... Sadly, it needs to be redone.",
        "Cv": 510025013.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Asimov",
        "ActorTalk": "Good thing the academic bar is high. With their current level, those rookies would ruin my reputation.",
        "Cv": 510025014.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "So even geniuses get annoyed when grading homework.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Asimov",
        "ActorTalk": "Hilarious.",
        "Cv": 510025015.0,
        "Desc": null
    }
]