        "ActorTalk": "(Let Kamui think)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Kamui",
        "ActorTalk": "I've got it! The answer is the third relocation!",
        "Cv": 510031046.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Projected Lecturer",
        "ActorTalk": "Hmm. Your classroom etiquette needs work, but I can see you're making an effort.",
        "Cv": 510031047.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Projected Lecturer",
        "ActorTalk": "You may be seated.",
        "Cv": 510031048.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Kamui",
        "ActorTalk": "Thanks, Commandant! Next time, I'll get it on my own for sure.",
        "Cv": 510031049.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Kamui",
        "ActorTalk": "I've got it! The answer is the fifth relocation!",
        "Cv": 510031050.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Projected Lecturer",
        "ActorTalk": "Confidence is commendable, young man, provided it's matched by competence.",
