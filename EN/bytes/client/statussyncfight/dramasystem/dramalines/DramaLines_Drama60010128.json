[
    {
        "TextId": 1,
        "ActorName": "Female Student",
        "ActorTalk": "Hello, Gray Raven Commandant. This is the Sinking Light Cloisters... a place for everyone to contemplate.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Female Student",
        "ActorTalk": "As you can see, this place has become a gathering spot for troubled people recently.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Female Student",
        "ActorTalk": "If you have time, would you like to listen to everyone's troubles?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "...I'll think about it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "What about you? Don't you have any troubles?",
