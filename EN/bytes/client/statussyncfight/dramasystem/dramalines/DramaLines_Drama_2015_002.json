[
    {
        "TextId": 1,
        "ActorName": "Alpha",
        "ActorTalk": "Wait.",
        "Cv": 510030027.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "What is it?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Alpha",
        "ActorTalk": "Not many people in this building, but I'd rather not draw attention. Low profile is better.",
        "Cv": 510030028.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "Should we wait until the area clears before moving?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Alpha",
        "ActorTalk": "I'm not wasting the day here. You have business of your own to return to, don't you?",
        "Cv": 510030029.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "So what's the plan?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Alpha",
        "ActorTalk": "Keep it natural. Avoid groups. Match pace. Stay on course. It's straightforward.",
        "Cv": 510030030.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Alpha",
        "ActorTalk": "Put simply, it's about who leads and who follows.",
        "Cv": 510030031.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "So the one following just... goes with the flow?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Alpha",
        "ActorTalk": "Exactly. So, what's it going to be? Taking point, or falling in behind me?",
        "Cv": 510030032.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "I'll lead.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Why don't you lead, Alpha?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Alpha",
        "ActorTalk": "Tch. Fine by me. You are the commandant, after all. Humans are expected to lead their Constructs.",
        "Cv": 510030033.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Alpha",
        "ActorTalk": "The route is yours, then. Move.",
        "Cv": 510030034.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Alpha",
        "ActorTalk": "Good call. Just follow my lead.",
        "Cv": 510030035.0,
        "Desc": null
    }
]