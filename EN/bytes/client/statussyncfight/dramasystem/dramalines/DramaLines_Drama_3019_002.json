[
    {
        "TextId": 1,
        "ActorName": "Alpha",
        "ActorTalk": "They're out of your league.",
        "Cv": 510037001.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "Alpha, why are you here?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "They...? Are there enemies?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Alpha",
        "ActorTalk": "I won't repeat myself.",
        "Cv": 510037002.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Alpha",
        "ActorTalk": "I don't care if you're the self-sacrificing type.",
        "Cv": 510037003.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Alpha",
        "ActorTalk": "If you tag along, I'll have more to pay attention to... You'll just get in my way.",
        "Cv": 510037004.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "All of you...?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "What's going on here...?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Alpha",
        "ActorTalk": "The best way to thank me... is to shut up and leave.",
        "Cv": 510037005.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "\u2014\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "(There's a terminal on the ground.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Is this... some kind of recording?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "(The terminal has returned to standby mode, its owner unknown. The projection seems to be an automatic playback triggered by an error.)",
        "Cv": null,
        "Desc": null
    }
]