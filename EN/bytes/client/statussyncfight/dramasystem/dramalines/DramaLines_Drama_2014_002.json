[
    {
        "TextId": 1,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "You're here.",
        "Cv": 510017050.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "I want to know... I freed my kin, yet none of them are living well. Why?",
        "Cv": 510017051.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "They do not pursue art... do not express preferences... do not even choose names for themselves...",
        "Cv": 510017052.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "They simply... act, without reason.",
        "Cv": 510017053.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "They're not like you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I don't have an answer.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "[PlayerName]",
        "ActorTalk": "They have their own minds.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Objectively speaking, they haven't awakened the way you have.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "Not awakened... I see. They are... still asleep.",
        "Cv": 510017054.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "As a human, I can't answer that.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "That is... disappointing. But... thank you for being honest.",
        "Cv": 510017055.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Maybe their idea of \"living\" just isn't the same as yours or mine.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "Then... does that mean they are living well, in their own way?",
        "Cv": 510017056.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "One more question. I want to know... what is the meaning of life?",
        "Cv": 510017057.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "[PlayerName]",
        "ActorTalk": "That's a pretty heavy question.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Uh... eat well? Sleep well?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I'd love to know that myself.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Awakened Kuroro",
        "ActorTalk": "I thought you would have the answer.",
        "Cv": 510017058.0,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "[PlayerName]",
        "ActorTalk": "The world's a complicated place. There are more questions than answers. We can't figure everything out.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "[PlayerName]",
        "ActorTalk": "But you can find your own answers. That much, I believe.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "Nanami",
        "ActorTalk": "Commandant! There you are!",
        "Cv": 510017059.0,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "Nanami",
        "ActorTalk": "I've been looking for you forever! We haven't played together in sooo long!",
        "Cv": 510017060.0,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "Nanami",
        "ActorTalk": "Huh? Kuhaha, were you looking for the Commandant too?",
        "Cv": 510017061.0,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Nanami? What are you doing here? And how do you know... Kuhaha?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Nanami",
        "ActorTalk": "Well, I was so bored... so I snuck into Babylonia.",
        "Cv": 510017062.0,
        "Desc": null
    }
]