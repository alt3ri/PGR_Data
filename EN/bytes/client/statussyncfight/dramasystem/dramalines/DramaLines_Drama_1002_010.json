[
    {
        "TextId": 1,
        "ActorName": "Rosetta",
        "ActorTalk": "Commandant... why are you inside my M.I.N.D.?",
        "Cv": 510015085.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Rosetta",
        "ActorTalk": "I see... I didn't realize things had gotten that bad. Maybe I was careless\u2014no, anything can happen in battle.",
        "Cv": 510015086.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Rosetta",
        "ActorTalk": "New Sophiasburgh was attacked by Corrupted... The glacier suddenly split open and they just kept pouring out.",
        "Cv": 510015087.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Rosetta",
        "ActorTalk": "I gathered my squad and we formed a defensive line. We held them back out on the ice.",
        "Cv": 510015088.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Rosetta",
        "ActorTalk": "Then in the middle of the fight, a jet-black Construct broke out from among the Corrupted and started attacking us.",
        "Cv": 510015089.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Rosetta",
        "ActorTalk": "I stayed behind to cover the retreat. And well... this is what happened.",
        "Cv": 510015090.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Rosetta",
        "ActorTalk": "Yes, and I checked\u2014they weren't an Ascendant. Oh, right, Commandant, you mentioned Miss Mina is here too?",
        "Cv": 510015091.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Rosetta",
        "ActorTalk": "She's a bit strange, and honestly kinda hates Babylonia. I didn't expect her to come along.",
        "Cv": 510015092.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Rosetta",
        "ActorTalk": "...Commandant?",
        "Cv": 510015093.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Rosetta",
        "ActorTalk": "...What?",
        "Cv": 510015094.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "(Explain the situation)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "What on earth happened?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "A Construct working with the Corrupted?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "Miss... Mina?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "Oh no.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "We've got a fake \"Mina\" amongst us.",
        "Cv": null,
        "Desc": null
    }
]