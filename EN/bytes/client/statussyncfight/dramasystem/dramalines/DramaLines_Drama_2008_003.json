[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Is this supposed to be part of the movie?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "Answer the call.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "Ignore the transmission and leave.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Wanshi",
        "ActorTalk": "Gray Raven Commandant... I can sense your presence...",
        "Cv": 510028039.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "Knew this scene was coming.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Wanshi",
        "ActorTalk": "Come... stay with me... forever...",
        "Cv": 510028026.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Next... I'll drag you into the eternal coffin... where you'll never escape... ugh!",
        "Cv": 510028027.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "(Turn your hand and grab his.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "(Reach out to touch his face.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Wanshi",
        "ActorTalk": "Argh!",
        "Cv": 510028037.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Wanshi",
        "ActorTalk": "You got me. It's just a projection.",
        "Cv": 510028038.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "No matter where you are, I swear I will find you...",
        "Cv": 510028040.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "Behind me, perhaps?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Wanshi",
        "ActorTalk": "...I've... finally...",
        "Cv": 510028024.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Found... you...",
        "Cv": 510028025.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Wanshi",
        "ActorTalk": "I'm right here\u2014you got caught by the \"ghost.\"",
        "Cv": 510028028.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Wanshi",
        "ActorTalk": "Did I scare you? I recorded this for the Youth Center's Children's Day event\u2014it's an interactive VR piece. Thought it turned out well, so I wanted to show you.",
        "Cv": 510028029.0,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "That was terrifying. You got me good.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": null,
        "ActorTalk": "Not even close.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Wanshi",
        "ActorTalk": "Sorry, I probably should've thought that through better.",
        "Cv": 510028030.0,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": null,
        "ActorTalk": "I'm kidding. I actually thought it was pretty clever.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": null,
        "ActorTalk": "Well, it's not just any \"ghost.\" It's you, Wanshi.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "Wanshi",
        "ActorTalk": "Yeah. Let's stay like this a little longer. Ghosts can only walk in the dark. If we turn on the lights, I'll vanish.",
        "Cv": 510028031.0,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "Wanshi",
        "ActorTalk": "Ghosts are greedy creatures... don't hold it against me, alright?",
        "Cv": 510028032.0,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Wanshi",
        "ActorTalk": "Close your eyes... let your thoughts quiet down... let the darkness take you in...",
        "Cv": 510028033.0,
        "Desc": null
    }
]