[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Is this supposed to be part of the movie?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Start watching the videotape)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Ooh... Gray Raven Commandant... I can sense your presence... No matter where you hide, I'll find you...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "When did you even record this?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Wow, interactive horror. Nice touch.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Blink twice if you're being held hostage.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Don't worry about that. I've already locked onto your signal... No matter how you hide, I'll find you...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "This is giving me serious classic horror movie vibes...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Terminal",
        "ActorTalk": "Ring, ring... Ring, ring...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Answer the call.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Hang up.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "You're the one who threw me in here... It's dark, freezing... my frozen hands clawing to get out... You should come in too... See what it's like... don't you think?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Don't worry... seven days from now... you won't escape my pursuit...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Terminal",
        "ActorTalk": "Ring, ring... Ring, ring...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Ahem... you'd better answer this one, or that ringing's not gonna stop.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Answer.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "You tossed me into this dark, freezing coffin, and I had to cut down every ghost trying to crawl out just to earn this one call...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "And I'm calling today to ask: When you pushed me in, did you ever think about the consequences? Heh.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Don't worry... In seven days... you won't escape me ever again...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "[PlayerName]",
        "ActorTalk": "A horror classic remake, huh?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Wanshi, don't mess with me like this.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "...I've... finally...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Found... you...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Knew that scene was coming.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Scream dramatically.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Come... stay with me... forever...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Next... I'll drag you into the eternal coffin... where you'll never escape... ugh!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Why did you freeze up? Did you fall asleep?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Wanshi, are you okay?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Commandant, I'm stuck.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 31,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Check his head.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 32,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Pinch his face.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 33,
        "ActorName": "\"Wanshi\"",
        "ActorTalk": "Got me. It's just a projection.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 34,
        "ActorName": "Wanshi",
        "ActorTalk": "I'm right here\u2014you got caught by the \"ghost.\"",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 35,
        "ActorName": "Wanshi",
        "ActorTalk": "Didn't think I'd trick you that easily.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 36,
        "ActorName": "Wanshi",
        "ActorTalk": "Did I scare you? I recorded this for the Youth Center's Children's Day event\u2014it's an interactive VR piece. Thought it turned out well, so I wanted to show you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 37,
        "ActorName": "[PlayerName]",
        "ActorTalk": "That was terrifying. You got me good.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 38,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Not even close.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 39,
        "ActorName": "Wanshi",
        "ActorTalk": "Sorry, I probably should've thought that through better.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 40,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I'm kidding. I actually thought it was pretty clever.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 41,
        "ActorName": "Wanshi",
        "ActorTalk": "Then you're my worst audience yet. When I performed this at the Youth Center, even the kids were fighting to answer the phone.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 42,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Well, it's not just any \"ghost.\" It's you, Wanshi.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 43,
        "ActorName": "Wanshi",
        "ActorTalk": "Yeah. Let's stay like this a little longer. Ghosts can only walk in the dark. If we turn on the lights, I'll vanish.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 44,
        "ActorName": "Wanshi",
        "ActorTalk": "I wish you could stay with me in this \"ice coffin\" just a little longer... maybe even \"forever,\" like they say in the movies.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 45,
        "ActorName": "Wanshi",
        "ActorTalk": "Ghosts are greedy creatures... don't hold it against me, alright?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 46,
        "ActorName": "Wanshi",
        "ActorTalk": "Close your eyes... let your thoughts quiet down... let the darkness take you in...",
        "Cv": null,
        "Desc": null
    }
]