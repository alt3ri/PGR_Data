[
    {
        "TextId": 1,
        "ActorName": "Haley",
        "ActorTalk": "Got a moment, [PlayerName]?",
        "Cv": 520005009.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Haley",
        "ActorTalk": "Yeah, I overheard what Ed told you.",
        "Cv": 520005010.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Haley",
        "ActorTalk": "One night after closing, I saw him just standing there staring at the sink, completely zoned out.",
        "Cv": 520005011.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Haley",
        "ActorTalk": "We're already understaffed, so he's under a ton of pressure. And now with those thugs showing up, we can't really do much to help...",
        "Cv": 520005012.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Haley",
        "ActorTalk": "But when I tried to comfort him, he looked up and said\u2014",
        "Cv": 520005013.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Haley",
        "ActorTalk": "\"Even if I'm no longer the manager of Kuroro Coffee, please keep serving everyone the best drinks you can, okay?\"",
        "Cv": 520005014.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Haley",
        "ActorTalk": "I'm really worried about him...",
        "Cv": 520005015.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "I was actually hoping to ask about Ross, too.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "Is this about the manager?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "Just keeping the cafe running is already a huge help to him.",
        "Cv": null,
        "Desc": null
    }
]