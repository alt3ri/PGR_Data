[
    {
        "TextId": 1,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "I feel woozy... Uh, yeah... Good thing we rigged up that rocket. Now we just wait for Babylonia to clean this up.",
        "Cv": 510015001.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "Huh? Oh. You're the Gray Raven Commandant.",
        "Cv": 510015002.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "So you just checked on Rosetta...",
        "Cv": 510015003.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "She got ambushed during a battle with the Corrupted. To save her life, we gave her a prototype frame.",
        "Cv": 510015004.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "But right after switching, she fell into a coma. No matter what we did, she wouldn't wake up.",
        "Cv": 510015005.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "So we brought her straight to Babylonia.",
        "Cv": 510015006.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "She's gotta make it through this...",
        "Cv": 510015007.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Arctic Mechanoid",
        "ActorTalk": "Ah... yeah, my head's a mess. Let me calm down for a bit.",
        "Cv": 510015008.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "What happened to Rosetta?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "(I should leave it be.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "You okay?",
        "Cv": null,
        "Desc": null
    }
]