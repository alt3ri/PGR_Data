[
    {
        "TextId": 1,
        "ActorName": "Lucia",
        "ActorTalk": "Commandant, I scanned the warehouse. Only one crate was tampered with.",
        "Cv": 510002093.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "The crate is full of spice containers. Some were broken, and spices are scattered all over.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Lucia",
        "ActorTalk": "Judging by the cuts, the tool used was sharp and had a wide blade\u2014strong enough to pierce the alloy material.",
        "Cv": 510002094.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lucia",
        "ActorTalk": "The spices show signs of being burned by intense heat, but not evenly. Looks like the cutting tool also had a basic heating module.",
        "Cv": 510002095.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Lucia",
        "ActorTalk": "That would mean the thief used...",
        "Cv": 510002096.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Lucia",
        "ActorTalk": "That's right. From what I can tell, the weapon was probably military-grade.",
        "Cv": 510002097.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lucia",
        "ActorTalk": "Also, the staff at Ocean Heart's flagship store are all mechanoids. Their laser tools don't match the results we're seeing.",
        "Cv": 510002100.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Since there are no other leads, let's narrow it down to humans and Constructs. We can check if anyone fits the profile.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "Right. Surveillance was jammed during the theft, but we can pull footage from nearby and track movement.",
        "Cv": 510002101.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lucia",
        "ActorTalk": "Understood, Commandant.",
        "Cv": 510002102.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Lucia",
        "ActorTalk": "But a laser gun wouldn't make such a clean cut.",
        "Cv": 510002098.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Lucia",
        "ActorTalk": "...Ultrasonic? Based on my experience, sonic weapons can't cut through metal.",
        "Cv": 510002099.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "(Examine supply crate)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "A long blade.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "A laser gun.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "Ultrasonic weapon.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "Let's do that.",
        "Cv": null,
        "Desc": null
    }
]