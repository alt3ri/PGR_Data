[
    {
        "TextId": 1,
        "ActorName": "Asimov",
        "ActorTalk": "What did you find?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "(Describe the scene seen in the surveillance footage)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Asimov",
        "ActorTalk": "You're saying an engineer was roaming around the Kuroros... and then they suddenly started moving and lining up...?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Asimov",
        "ActorTalk": "That's highly suspicious...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "That makes two of us.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "What should we do with it?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Asimov",
        "ActorTalk": "Let's investigate the ground. If he was lingering here, there would definitely be footprints scattered all over the floor. We can use those to track him down.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "How do we find it?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "Scan Vision can do that?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Asimov",
        "ActorTalk": "That's right, Scan Vision also has an integrated tracking protocol.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Asimov",
        "ActorTalk": "Why're you so surprised? It's normal for beta systems to have some experimental features. I'll update the privacy terms accordingly in future versions...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Asimov",
        "ActorTalk": "Anyway... let's scan the surroundings first. Maybe the suspect left behind some clues.",
        "Cv": null,
        "Desc": null
    }
]