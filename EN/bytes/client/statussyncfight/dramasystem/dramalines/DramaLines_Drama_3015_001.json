[
    {
        "TextId": 1,
        "ActorName": "Chrome",
        "ActorTalk": "Back then, being here was an honor, but I also felt the weight of it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Chrome",
        "ActorTalk": "I prepared. Trained hard. Did everything I could. Still felt like I might come up short.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "From where I stand, you've never fallen short.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "You're tougher on yourself than anyone else is.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Chrome",
        "ActorTalk": "Your words always steady me.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Chrome",
        "ActorTalk": "Having you here by my side now, most of that pressure is just gone.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Chrome",
        "ActorTalk": "Because I know you've got my back. Always have.",
        "Cv": null,
        "Desc": null
    }
