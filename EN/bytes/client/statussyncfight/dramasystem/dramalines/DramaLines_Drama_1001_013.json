[
    {
        "TextId": 1,
        "ActorName": "Talkative Waiter",
        "ActorTalk": "Customers, please take a number and wait in line. We appreciate your cooperation.",
        "Cv": 510000212.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "We have a reservation.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Talkative Waiter",
        "ActorTalk": "Let me check... Oh! Your turn just came up. Your table's ready on the second floor. Right this way, please.",
        "Cv": 510000213.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lucia",
        "ActorTalk": "Besides the new dishes, is there anything else you'd like to try, Commandant?",
        "Cv": 510000215.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Lucia",
        "ActorTalk": "These two are highly rated. Lots of people say they're unique and have a really refreshing flavor.",
        "Cv": 510000216.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Then let's go with your picks.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Busy Waiter",
        "ActorTalk": "Here are your dishes. Enjoy the meal.",
        "Cv": 510000218.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Lucia",
        "ActorTalk": "There's more food than I expected.",
        "Cv": 510000219.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "Turning simple ingredients into something so special... Kowloong's culinary skills really are something else.",
        "Cv": 510000220.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lucia",
        "ActorTalk": "Try it, Commandant.",
        "Cv": 510000221.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Lucia",
        "ActorTalk": "...A photo?",
        "Cv": 510000222.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "[PlayerName]",
        "ActorTalk": "It's not every day we get a feast like this. Let's capture the moment.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Lucia",
        "ActorTalk": "Do we both need to be in it?",
        "Cv": 510000223.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Of course! Look at the camera\u2014",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Lucia",
        "ActorTalk": "...Okay. Is this angle all right, Commandant?",
        "Cv": 510000224.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Lucia",
        "ActorTalk": "Cheese.",
        "Cv": 510000225.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Photo's done. Let's eat.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Lucia",
        "ActorTalk": "Commandant, you've got some sauce on your lip. Let me wipe it off.",
        "Cv": 510000226.0,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "Lucia",
        "ActorTalk": "Let's enjoy these dishes together, Commandant.",
        "Cv": 510000227.0,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Lucia",
        "ActorTalk": "Really? Hold still, let me take a look...",
        "Cv": 510000228.0,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "Lucia",
        "ActorTalk": "The server mentioned that some of these dishes taste even better when paired together.",
        "Cv": 510000229.0,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Which ones? Let's try them.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "Lucia",
        "ActorTalk": "Like this one and this one, Commandant\u2014",
        "Cv": 510000230.0,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": null,
        "ActorTalk": "(Lucia lifts the food with her chopsticks, and you take a bite. The blend of flavors spreads and deepens as you chew.)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Lucia",
        "ActorTalk": "Pairing different ingredients like this creates a whole new flavor. Looks like the chef had that in mind all along.",
        "Cv": 510000231.0,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "Lucia",
        "ActorTalk": "Want to try a few other combinations, Commandant?",
        "Cv": 510000232.0,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Want to try it, Lucia?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": "Lucia",
        "ActorTalk": "Sure.",
        "Cv": 510000233.0,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": "[PlayerName]",
        "ActorTalk": "So? How is it?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": "Lucia",
        "ActorTalk": "It tastes really good. If we get the chance, let's try cooking Kowloong-style dishes together sometime.",
        "Cv": 510000234.0,
        "Desc": null
    },
    {
        "TextId": 31,
        "ActorName": null,
        "ActorTalk": "Got any recommendations, Lucia?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 32,
        "ActorName": null,
        "ActorTalk": "I'll have one of everything.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 33,
        "ActorName": null,
        "ActorTalk": "Want to take a photo together first?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 34,
        "ActorName": null,
        "ActorTalk": "(Sample the dish)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 35,
        "ActorName": null,
        "ActorTalk": "Yep. Say cheese\u2014",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 36,
        "ActorName": null,
        "ActorTalk": "Thanks, Lucia.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 37,
        "ActorName": null,
        "ActorTalk": "Think there's some on the other side too...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 38,
        "ActorName": null,
        "ActorTalk": "I think these few would go great together too.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 39,
        "ActorName": null,
        "ActorTalk": "I'm getting a bit full.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 40,
        "ActorName": null,
        "ActorTalk": "All right, then... I'll order one of each.",
