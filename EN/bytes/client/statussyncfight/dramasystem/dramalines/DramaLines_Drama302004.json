[
    {
        "TextId": 1,
        "ActorName": "Harley Jo",
        "ActorTalk": "I used to be able to take a round or two off you at least, but now I can't beat you even once...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Harley Jo",
        "ActorTalk": "Sigh... I should just play dirty next time.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "I heard it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "I just got lucky.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Harley Jo",
        "ActorTalk": "Hearing something and being able to see through it are two different things, haha.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Harley Jo",
        "ActorTalk": "Being too modest isn't a good habit either, you know, \u3010kuroname\u3011.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Harley Jo",
        "ActorTalk": "Jokes aside\u2014you've won. As the winner, you can make one request of me, just as we agreed.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "I'm curious what you wanted to ask for originally.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Harley Jo",
        "ActorTalk": "I want you to let me tag along the next time you're doing something big.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "Huh?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "What do you mean?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Harley Jo",
        "ActorTalk": "You've all done so many incredible things on the front lines recently. Everyone respects you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Harley Jo",
        "ActorTalk": "But me? I'm never there when it matters.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "You have other missions, don't you?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "Do you want to be respected?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Harley Jo",
        "ActorTalk": "Other missions are certainly important, but... \u3010kuroname\u3011, we're classmates, and that's even more important. Don't leave me behind.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Harley Jo",
        "ActorTalk": "Everyone wants to be respected, but more than that... \u3010kuroname\u3011, we're classmates. Don't leave me behind.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Harley Jo",
        "ActorTalk": "Things are only going to get more dangerous from here. I want to fight alongside you too.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "...I've decided on my request.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Harley Jo",
        "ActorTalk": "What is it?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "\u3010kuroname\u3011",
        "ActorTalk": "Beat me the next time we compete.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "Harley Jo",
        "ActorTalk": "...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "Harley Jo",
        "ActorTalk": "You want me to beat you first before making my request, huh? Sure! I won't lose next time!",
        "Cv": null,
        "Desc": null
    }
]