[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Why are there two elevator control panels here?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Teddy",
        "ActorTalk": "That's not an elevator panel. Go on, put your hand on it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Huh? A screen popped up.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Teddy",
        "ActorTalk": "It's a program I put together. It creates a virtual world for firearm training.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Teddy",
        "ActorTalk": "Ideally it belongs in a simulation room, but approvals take time. For now, it's staying outside, waiting for the right person to find it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Won't someone trigger it by accident if it's next to the elevator?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Teddy",
        "ActorTalk": "Don't worry. I've locked it down. Only authorized people can start it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Thoughtfully designed.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Nicely done.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Teddy",
        "ActorTalk": "Of course, you're on the list too. Since you're one of the chosen few, want to test the program with me?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Looks like I don't have much of a reason to say no.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Lee",
        "ActorTalk": "This should be the spot Teddy mentioned.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Rosetta",
        "ActorTalk": "Oh, Commandant is here too.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Teddy",
        "ActorTalk": "You two, this is the place.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Lee? Rosetta? What are you two doing here?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Lee",
        "ActorTalk": "Teddy said there's a new combat sim to test, so here I am.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Rosetta",
        "ActorTalk": "Same here. Teddy invited me, and I ran into Mr. Lee on the way.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "[PlayerName]",
        "ActorTalk": "So what do we do next?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "Teddy",
        "ActorTalk": "We enter the virtual space, pick a location, and it starts automatically. Each session needs two people...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Lee",
        "ActorTalk": "I'll team up with the Commandant.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "Rosetta",
        "ActorTalk": "Me neither.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "Teddy",
        "ActorTalk": "Then it's settled. You'll spar with each of us in turn, Commandant. That works for you, right?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I'm fine with it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Let's get started, then.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Challenge Teddy.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Challenge Lee.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Challenge Rosetta.",
        "Cv": null,
        "Desc": null
    }
]