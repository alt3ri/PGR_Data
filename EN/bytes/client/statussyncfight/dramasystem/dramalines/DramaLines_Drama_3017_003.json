[
    {
        "TextId": 1,
        "ActorName": "Vanessa",
        "ActorTalk": "How amusing. Why don't we just turn the classroom into a lounge while we're at it?",
        "Cv": 510035012.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Vanessa",
        "ActorTalk": "What's the point of all this hand-holding? Giving pep talks to children is a waste of my time.",
        "Cv": 510035013.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "They're students who've been through a major trauma.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Finding ways to cope now shows resilience. It might just save them later.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Vanessa",
        "ActorTalk": "Oh? So would you be attending social hour after trauma like that?",
        "Cv": 510035014.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Everyone copes differently.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "[PlayerName]",
        "ActorTalk": "...No.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Vanessa",
        "ActorTalk": "Heh. The great Chief has spoken. Who am I to argue?",
        "Cv": 510035015.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Vanessa",
        "ActorTalk": "Perhaps by our next visit, F.O.S. will be operating as a therapy clinic.",
        "Cv": 510035016.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Vanessa",
        "ActorTalk": "Exactly. And that's why the weak become nothing but dead weight.",
        "Cv": 510035017.0,
        "Desc": null
    }
]