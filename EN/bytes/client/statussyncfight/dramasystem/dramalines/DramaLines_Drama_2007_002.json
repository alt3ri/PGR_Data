[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(Is that... the legendary Affection meter?)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Lee",
        "ActorTalk": "Why are you... staring at me like that?",
        "Cv": 510010008.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "I knew it. It really does change.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lee",
        "ActorTalk": "Why are you suddenly getting so close?!",
        "Cv": 510010009.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "(Pat Lee's head)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "(Hold Lee's hand)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lee",
        "ActorTalk": "You think you can just touch me and get away?",
        "Cv": 510010010.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Lee",
        "ActorTalk": "If you're going to do something, do it right. Don't start and then bail halfway.",
        "Cv": 510010011.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "I just thought you might not like it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lee",
        "ActorTalk": "That doesn't matter. As long as you like it, that's enough.",
        "Cv": 510010012.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Lee",
        "ActorTalk": "Next time, just say so.",
        "Cv": 510010013.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Lee",
        "ActorTalk": "I won't turn you down.",
        "Cv": 510010014.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "Do you like it, Lee?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Lee",
        "ActorTalk": "That's something I should be asking you.",
        "Cv": 510010015.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "Then...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "(Gently pinch Lee's cheek)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "(Pull your hand back and step away)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Lee",
        "ActorTalk": "So this is some kind of patience test now.",
        "Cv": 510010016.0,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "Lee",
        "ActorTalk": "Or maybe you're trying out a new trick. Go on, what's next?",
        "Cv": 510010017.0,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": null,
        "ActorTalk": "Is that permission to keep going?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "Lee",
        "ActorTalk": "Do what you want. Just remember, I'll return the favor later, with interest.",
        "Cv": 510010018.0,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "Lee",
        "ActorTalk": "That's enough. Stop backing away already.",
        "Cv": 510010019.0,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": null,
        "ActorTalk": "I just wanted to give you some space.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "Lee",
        "ActorTalk": "No need. Does it really make you feel better to stay away from me?",
        "Cv": 510010020.0,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Lee",
        "ActorTalk": "I never said I minded you being close. Rather, it's the distance that bothers me.",
        "Cv": 510010021.0,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "Lee",
        "ActorTalk": "Go on, what do you want to do next? I still don't understand why you enjoy this so much, but that's fine.",
        "Cv": 510010022.0,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": null,
        "ActorTalk": "How do you even know what I'm thinking, Lee?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": null,
        "ActorTalk": "Don't be ridiculous, I wasn't enjoying it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": "Lee",
        "ActorTalk": "The number above your head keeps going up. It gives you away.",
        "Cv": 510010023.0,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": null,
        "ActorTalk": "Wait, I have one too?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 31,
        "ActorName": "Lee",
        "ActorTalk": "Oh, so you can see mine too, huh? No wonder you were acting that way.",
        "Cv": 510010024.0,
        "Desc": null
    },
    {
        "TextId": 32,
        "ActorName": null,
        "ActorTalk": "I was just curious, that's all...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 33,
        "ActorName": "Lee",
        "ActorTalk": "Next time, just ask. I won't hide anything from you.",
        "Cv": 510010025.0,
        "Desc": null
    },
    {
        "TextId": 34,
        "ActorName": "Lee",
        "ActorTalk": "But that little stunt just now\u2014I should probably return the favor.",
        "Cv": 510010026.0,
        "Desc": null
    },
    {
        "TextId": 35,
        "ActorName": null,
        "ActorTalk": "That wasn't a stunt!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 37,
        "ActorName": "Lee",
        "ActorTalk": "Doesn't matter. What's important is that you fix the numbers you just lost.",
        "Cv": 510010027.0,
        "Desc": null
    },
    {
        "TextId": 38,
        "ActorName": "Lee",
        "ActorTalk": "Get ready. You're not leaving until it hits 100%.",
        "Cv": 510010028.0,
        "Desc": null
    }
]