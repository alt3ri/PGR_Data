[
    {
        "TextId": 1,
        "ActorName": "Selena",
        "ActorTalk": "People used to love listening to music like this\u2014on a quiet afternoon, on a bus ride, or during a rainy day.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Selena",
        "ActorTalk": "In stories, it's always two people, one pair of earbuds, one song. The feelings they can't say aloud, the silent look in their eyes\u2014everything gets passed along through that little wire between them.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Selena",
        "ActorTalk": "This gallery event follows a similar idea. WGAA wants people to create something with someone close to them\u2014something that belongs to both.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "So you invited me.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "...\"Someone special\"?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Selena",
        "ActorTalk": "You already know who I had in mind, don't you?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Selena",
        "ActorTalk": "The person I want to create with... is standing right in front of me.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "Looks like we feel the same way.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Selena",
        "ActorTalk": "The gallery's prepared all sorts of activities. So... just like always, I'll let you decide, Conductor.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "Music Creation: [Touch of Sound].",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "Creative Writing: [The Vanishing Letter].",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "That's romantic.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "An unforgettable experience.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Selena",
        "ActorTalk": "Then maybe we should try it sometime too.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Selena",
        "ActorTalk": "Time spent with someone special is always unforgettable.",
        "Cv": null,
        "Desc": null
    }
]