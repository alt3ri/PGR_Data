[
    {
        "TextId": 1,
        "ActorName": "Selena",
        "ActorTalk": "People used to love listening to music like this\u2014on a quiet afternoon, during a bus ride, or on a rainy day.",
        "Cv": 510027001.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Selena",
        "ActorTalk": "In stories, it's always two people, one pair of earbuds, one song. Everything gets passed along through that short wire between them.",
        "Cv": 510027002.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "That's romantic.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "An unforgettable experience.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Selena",
        "ActorTalk": "Then maybe we should try it sometime too.",
        "Cv": 510027003.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Selena",
        "ActorTalk": "Well, time spent with someone special is always unforgettable.",
        "Cv": 510027004.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Selena",
        "ActorTalk": "This gallery event follows a similar idea. The WGAA wants people to create something with someone special\u2014something that belongs to both.",
        "Cv": 510027005.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "So you invited me.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "...\"Someone special\"?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Selena",
        "ActorTalk": "You already know who I had in mind, don't you?",
        "Cv": 510027006.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Selena",
        "ActorTalk": "The person I want to create with... is standing right in front of me.",
        "Cv": 510027007.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Looks like we feel the same way.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Selena",
        "ActorTalk": "The gallery's prepared all sorts of activities. So... just like always, I'll let you decide, Conductor.",
        "Cv": 510027008.0,
        "Desc": null
    },
