[
    {
        "TextId": 1,
        "ActorName": "Wanshi",
        "ActorTalk": "You're here, [PlayerName].",
        "Cv": 510028001.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Sorry, did I keep you waiting?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Wanshi",
        "ActorTalk": "I didn't want you waiting around, so I came a bit early.",
        "Cv": 510028002.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Wanshi",
        "ActorTalk": "I was stuck on missions all day yesterday. Didn't finish until late at night.",
        "Cv": 510028003.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "You look exhausted. Did you actually get any rest?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Wanshi",
        "ActorTalk": "It's fine. I rested between missions. Whenever I closed my eyes, I kept thinking about watching movies with you all day.",
        "Cv": 510028004.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Wanshi",
        "ActorTalk": "Which theater to go to, what kind of movie to watch, what to do after... just figuring out how to make today a little more special.",
        "Cv": 510028005.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Besides the movie, do you have other plans?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Or should I check your sleep data from last night?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Wanshi",
        "ActorTalk": "Of course. I set up a comfy couch in the lounge. After the movie, we can go crash there for a nap.",
        "Cv": 510028034.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Wanshi",
        "ActorTalk": "But for now, let's just focus on enjoying the movie.",
        "Cv": 510028035.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Wanshi",
        "ActorTalk": "We can plan the rest in our dreams later. For now, how about picking a theater mode?",
        "Cv": 510028036.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Wanshi",
        "ActorTalk": "According to the theater guide, we can choose between a classic private screening room or a real-time VR experience.",
        "Cv": 510028006.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Wanshi",
        "ActorTalk": "[PlayerName], I'll let you decide.",
        "Cv": 510028007.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Private theater",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "[PlayerName]",
        "ActorTalk": "VR experience",
        "Cv": null,
        "Desc": null
    }
]