[
    {
        "TextId": 1,
        "ActorName": "Bianca",
        "ActorTalk": "Commandant? I didn't expect to meet you here.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Bianca",
        "ActorTalk": "There's still some time before we have to leave for the mission. Did you need something, Commandant?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Bianca",
        "ActorTalk": "Yes, Commandant.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Bianca",
        "ActorTalk": "I've already checked all my equipment and weapons. I just wanted to collect my thoughts here before leaving.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Bianca",
        "ActorTalk": "The scenery here always brings me peace. It helps me stay focused before a mission.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Bianca",
        "ActorTalk": "I am reflecting on some things\u2014faith, duty, and the smiling faces that I need to protect.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Bianca",
        "ActorTalk": "Whenever I see moments of peace, it gives meaning to my blade.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Bianca",
        "ActorTalk": "Thank you for your concern, Commandant.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Bianca",
        "ActorTalk": "I appreciate your kindness, Commandant.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Bianca",
        "ActorTalk": "All preparations are complete. Please don't worry about it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Bianca",
        "ActorTalk": "Your concern is the greatest support I could ask for.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Bianca",
        "ActorTalk": "Understood, Commandant. I should be heading out now. Please take care, and I'll see you soon.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "Preparing for your mission?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "You seem deep in thought?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "Need my help?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "I'll leave you be, then.",
        "Cv": null,
        "Desc": null
    }
]