[
    {
        "TextId": 1,
        "ActorName": "Lee",
        "ActorTalk": "Judging by the artificial lighting here in Dreamglow Gardens...",
        "Cv": 510024013.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Lee",
        "ActorTalk": "Babylonia should have good weather today too.",
        "Cv": 510024014.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "But the universe stays dark and quiet... that's what you're thinking, isn't it, Lee?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lee",
        "ActorTalk": "You're free to guess. I reserve the right to stay silent.",
        "Cv": 510024015.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "But you said something similar back at the security bridge.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Lee",
        "ActorTalk": "That's... not an accurate comparison.",
        "Cv": 510024016.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lee",
        "ActorTalk": "At the very least, I don't feel the same now.",
        "Cv": 510024017.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Huh? What'd you say?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lee",
        "ActorTalk": "Nothing.",
        "Cv": 510024018.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Not again. Lee, say important things at a normal volume.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "...Even a kitten is louder than you.",
        "Cv": null,
        "Desc": null
    }
]