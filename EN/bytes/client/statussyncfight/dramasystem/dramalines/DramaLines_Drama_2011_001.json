[
    {
        "TextId": 1,
        "ActorName": "Karenina",
        "ActorTalk": "Did you see anyone suspicious around here, Commandant?",
        "Cv": 510017002.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Karenina",
        "ActorTalk": "Based on that strange signal earlier, we're definitely after the same target.",
        "Cv": 510017003.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Karenina",
        "ActorTalk": "Dahei, did you see anyone suspicious?",
        "Cv": 510017004.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Dahei, Engineering Force Technician",
        "ActorTalk": "I... I think so, but it disappeared into the crowd instantly...",
        "Cv": 510017005.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Karenina",
        "ActorTalk": "DAMMIT!",
        "Cv": 510017006.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "So... what exactly is going on?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Ahhh... nope. Still don't get it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Dahei, Engineering Force Technician",
        "ActorTalk": "Let me explain! The Engineering Force was testing a batch of civilian helper AI Kuroros.",
        "Cv": 510017015.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Dahei, Engineering Force Technician",
        "ActorTalk": "Someone tampered with their data... and the whole batch ran away.",
        "Cv": 510017016.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Dahei, Engineering Force Technician",
        "ActorTalk": "Now they're disguised as humans and scattered across four areas: Dreamglow Gardens, Logistics Center, Babylonia Universal Cinema, and Olympia Art Gallery.",
        "Cv": 510017017.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "So basically...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "[PlayerName]",
        "ActorTalk": "We're unmasking fake Kuroros.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Karenina",
        "ActorTalk": "That's the situation. I still have to track down whoever hacked the Engineering Force's network, so we're a bit short-handed right now.",
        "Cv": 510017007.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Karenina",
        "ActorTalk": "Commandant, can you lend the Engineering Force a hand? With this updated camera, you can spot Kuroros hiding among the crowd.",
        "Cv": 510017008.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Karenina",
        "ActorTalk": "And as for your reward... once the job's done, I'll grant you one request!",
        "Cv": 510017009.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Any request at all?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Karenina",
        "ActorTalk": "W-well... keep it reasonable, okay?!",
        "Cv": 510017010.0,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Alright, I'm in.",
        "Cv": null,
        "Desc": null
    }
]