[
    {
        "TextId": 1,
        "ActorName": "F.O.S. Student Ren",
        "ActorTalk": "Ugh, these drones are impossible to control! You hanging in there, Lylian?",
        "Cv": 510029065.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "F.O.S. Student Lylian",
        "ActorTalk": "Mine are stable... for now. I think.",
        "Cv": 510029066.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Sica",
        "ActorTalk": "We don't have much time left. We can't let everyone down!",
        "Cv": 510029067.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Vanessa",
        "ActorTalk": "Well, well. If it isn't Ms. Top Student. Care to explain yourself?",
        "Cv": 510029068.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Sica",
        "ActorTalk": "Ah! Vanessa! A-and... Chief! Lucia, too! What a surprise!",
        "Cv": 510029069.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Sica",
        "ActorTalk": "That's true, but... I could never hold a candle to a Chief of your caliber!",
        "Cv": 510029070.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Sica",
        "ActorTalk": "Ah, yes!",
        "Cv": 510029071.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Vanessa",
        "ActorTalk": "You still haven't answered my question. What is all this?",
        "Cv": 510029072.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Sica",
        "ActorTalk": "We're preparing a performance for after the award ceremony.",
        "Cv": 510029073.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lucia",
        "ActorTalk": "With these drones?",
        "Cv": 510029074.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Sica",
        "ActorTalk": "Yes! We're programming them into light formations... Oh! Would you like to see a preview, Chief? It could be our final rehearsal!",
        "Cv": 510029075.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "F.O.S. Student Ren",
        "ActorTalk": "Looks like we've got no other choice, Lylian!",
        "Cv": 510029076.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "F.O.S. Student Lylian",
        "ActorTalk": "Why are you suddenly so worked up...",
        "Cv": 510029077.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Lucia",
        "ActorTalk": "It really was. Was that final shape the F.O.S. insignia?",
        "Cv": 510029078.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Sica",
        "ActorTalk": "Yes! You recognized it! That means all our late nights were worth it!",
        "Cv": 510029079.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Vanessa",
        "ActorTalk": "The launch sequence was sloppy, and the transitions lacked punch. You've had time to prepare. Is this really your best?",
        "Cv": 510029080.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Sica",
        "ActorTalk": "W-we'll use every last minute to practice! We won't disappoint!",
        "Cv": 510029081.0,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Vanessa",
        "ActorTalk": "Go back to your practice, then. Just don't make any mistakes during the actual event.",
        "Cv": 510029082.0,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "Sica",
        "ActorTalk": "Understood!",
        "Cv": 510029083.0,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": null,
        "ActorTalk": "You're a Chief as well, aren't you?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": null,
        "ActorTalk": "Relax, Sica. It's just us.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": null,
        "ActorTalk": "That was impressive work.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": null,
        "ActorTalk": "Give them a break, Vanessa.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "Lucia",
        "ActorTalk": "Actually, I have a small request. Before we go to the ceremony, Commandant, Vanessa... would you mind if we took a photo together?",
        "Cv": 510029057.0,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Vanessa",
        "ActorTalk": "?",
        "Cv": 510029058.0,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "Lucia",
        "ActorTalk": "To send to Lee and Liv. They couldn't attend, but they asked us to document the day. We promised them before they left.",
        "Cv": 510029059.0,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": "Vanessa",
        "ActorTalk": "I am not participating in your commemorative snapshot. Take your picture with just the two of you.",
        "Cv": 510029060.0,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": null,
        "ActorTalk": "Sure, let's take one.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": "Sica",
        "ActorTalk": "Come on, let's take it together!",
        "Cv": 510029144.0,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": "Sica",
        "ActorTalk": "Say Cheese!",
        "Cv": 510029145.0,
        "Desc": null
    }
]