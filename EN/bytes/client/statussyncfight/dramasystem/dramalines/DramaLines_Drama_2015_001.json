[
    {
        "TextId": 1,
        "ActorName": "Training Kuroro",
        "ActorTalk": "I don't recognize your signature. What's your business in F.O.S.?!",
        "Cv": 510030001.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Alpha",
        "ActorTalk": "...",
        "Cv": 510030002.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Your silence is noted, but meaningless. My strongest backup is already on the way!",
        "Cv": 510030003.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "Alpha?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Alpha",
        "ActorTalk": "This is your \"strongest backup\"?",
        "Cv": 510030004.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Training Kuroro",
        "ActorTalk": "That's ri\u2014 Wait, that look you just exchanged... don't tell me you two know each other?",
        "Cv": 510030005.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "We do, but it's...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "Alpha, why are you...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Alpha",
        "ActorTalk": "...Get this metal chunk out of our way, and I'll tell you everything you want to know.",
        "Cv": 510030006.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "What are you doing at F.O.S.?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Alpha",
        "ActorTalk": "I'll explain later.",
        "Cv": 510030007.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Well, you could've mentioned you know the Gray Raven Commandant. That changes things.",
        "Cv": 510030008.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Alpha",
        "ActorTalk": "Then move.",
        "Cv": 510030009.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Not so fast. I can't permit an unchecked person to roam F.O.S. freely... unless...",
        "Cv": 510030010.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "Unless what?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Unless they're under proper supervision.",
        "Cv": 510030011.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "What are these?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Tactical restraint cuffs, specialized gear for containing high-risk targets. Made from the latest high-tensile alloy, top of the line.",
        "Cv": 510030012.0,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": "Alpha",
        "ActorTalk": "\"High-risk targets\"... including the Gray Raven Commandant?",
        "Cv": 510030013.0,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Young people these days only hear what they want to hear. I said someone needs to supervise, didn't I?",
        "Cv": 510030014.0,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": null,
        "ActorTalk": "You want me to be her supervisor?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Coincidentally, I was asked to field-test these anyway. Fine, I'll authorize this unregistered Construct's limited movement within the academy.",
        "Cv": 510030015.0,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": "Training Kuroro",
        "ActorTalk": "But you must stay by her side as her supervisor, to prevent any... incidents.",
        "Cv": 510030016.0,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": null,
        "ActorTalk": "So that means we can move freely now?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": null,
        "ActorTalk": "Do you really have to cuff me too?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": "Training Kuroro",
        "ActorTalk": "Exactly! Just wrap up your business and meet me at the Monument Plaza. I'll remove the cuffs then.",
        "Cv": 510030017.0,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": "Training Kuroro",
        "ActorTalk": "An instructor's orders are absolute! Once you're done, come find me at the Monument Plaza to get unlocked!",
        "Cv": 510030018.0,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": "Alpha",
        "ActorTalk": "Let's go.",
        "Cv": 510030019.0,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": null,
        "ActorTalk": "Wait... You still haven't told me why you're really here.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": "Alpha",
        "ActorTalk": "...My previous engagements at F.O.S. left significant data traces behind.",
        "Cv": 510030020.0,
        "Desc": null
    },
    {
        "TextId": 31,
        "ActorName": "Alpha",
        "ActorTalk": "If I don't delete them, someone could track me later, or worse, replicate something from them.",
        "Cv": 510030021.0,
        "Desc": null
    },
    {
        "TextId": 32,
        "ActorName": null,
        "ActorTalk": "So you're only here to delete data?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 33,
        "ActorName": "Alpha",
        "ActorTalk": "Believe what you want. That's my only business here today. Nothing more.",
        "Cv": 510030022.0,
        "Desc": null
    },
    {
        "TextId": 34,
        "ActorName": null,
        "ActorTalk": "I believe you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 35,
        "ActorName": null,
        "ActorTalk": "If I didn't, I couldn't supervise you properly, could I?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 36,
        "ActorName": "Alpha",
        "ActorTalk": "...Then let's move. That data's been sitting too long. I'd rather not encounter surprises.",
        "Cv": 510030023.0,
        "Desc": null
    },
    {
        "TextId": 37,
        "ActorName": "Alpha",
        "ActorTalk": "Heh, ready to move out now, Supervisor?",
        "Cv": 510030024.0,
        "Desc": null
    },
    {
        "TextId": 38,
        "ActorName": null,
        "ActorTalk": "Let's go delete that data.",
        "Cv": null,
        "Desc": null
    }
]