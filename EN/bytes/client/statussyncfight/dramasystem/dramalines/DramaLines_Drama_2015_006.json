[
    {
        "TextId": 1,
        "ActorName": "Alpha",
        "ActorTalk": "...",
        "Cv": 510030108.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "That \"standby\" could last a while.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "Seems the instructors are still searching for us.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Alpha",
        "ActorTalk": "Then we're not waiting around.",
        "Cv": 510030109.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Alpha",
        "ActorTalk": "They would have found us eventually.",
        "Cv": 510030110.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "What are you doing?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Alpha",
        "ActorTalk": "The moment I deleted that data, every security protocol F.O.S. had tied to me went offline.",
        "Cv": 510030111.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Alpha",
        "ActorTalk": "It won't be long before this place is swarming.",
        "Cv": 510030112.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "There should be another way.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "Our first priority is getting these cuffs off.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Alpha",
        "ActorTalk": "For example... me cutting through the canopy of F.O.S. and taking you out of here.",
        "Cv": 510030123.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "...I don't think that's a viable option.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Alpha",
        "ActorTalk": "I won't do it, because... I didn't intend to do it back then either.",
        "Cv": 510030124.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Alpha",
        "ActorTalk": "What must be abandoned should be abandoned. What must be let go should be let go too.",
        "Cv": 510030125.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Alpha",
        "ActorTalk": "Since we can't reach a consensus, all that's left to do is\u2014",
        "Cv": 510030126.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Alpha",
        "ActorTalk": "I've severed the energy link between the cuffs. The physical lock remains, for your security audit.",
        "Cv": 510030127.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": "Alpha",
        "ActorTalk": "But in the process... I've left my digital signature all over this hardware.",
        "Cv": 510030115.0,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "I just won't hand them in for analysis.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": null,
        "ActorTalk": "That shouldn't cause issues, right?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": "Alpha",
        "ActorTalk": "Not everything follows your ideal script.",
        "Cv": 510030116.0,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": "Alpha",
        "ActorTalk": "You. That girl. Everyone I crossed paths with here... all traces I failed to \"delete.\"",
        "Cv": 510030117.0,
        "Desc": null
    },
    {
        "TextId": 22,
        "ActorName": null,
        "ActorTalk": "You can't just \"delete\" people, you know.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 23,
        "ActorName": null,
        "ActorTalk": "Data aside, connecting with people isn't a bad thing.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 24,
        "ActorName": "Alpha",
        "ActorTalk": "Humans are always the most complicated variables. Leaving imprints in their worlds, forging bonds...",
        "Cv": 510030118.0,
        "Desc": null
    },
    {
        "TextId": 25,
        "ActorName": "Alpha",
        "ActorTalk": "It only creates liabilities. That's why I wanted to erase it all.",
        "Cv": 510030119.0,
        "Desc": null
    },
    {
        "TextId": 26,
        "ActorName": null,
        "ActorTalk": "It's precisely those traces that let us fight side by side before.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 27,
        "ActorName": null,
        "ActorTalk": "It's precisely those traces that made that girl help us.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 28,
        "ActorName": "Alpha",
        "ActorTalk": "Tch. You and your sentimental speeches.",
        "Cv": 510030120.0,
        "Desc": null
    },
    {
        "TextId": 29,
        "ActorName": "Alpha",
        "ActorTalk": "Time's up. They'll be here soon. When they are, improvise. Throw them off the scent.",
        "Cv": 510030121.0,
        "Desc": null
    },
    {
        "TextId": 30,
        "ActorName": null,
        "ActorTalk": "Goodbye, Alpha.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 31,
        "ActorName": "Alpha",
        "ActorTalk": "I don't say goodbye.",
        "Cv": 510030122.0,
        "Desc": null
    }
]