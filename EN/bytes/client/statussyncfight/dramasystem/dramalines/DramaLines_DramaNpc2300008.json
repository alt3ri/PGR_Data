        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Dudu",
        "ActorTalk": "We still don't have a solution for the Red Tide, but we can deal with other harsh environments just fine.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "That's impressive.",
        "Cv": null,
