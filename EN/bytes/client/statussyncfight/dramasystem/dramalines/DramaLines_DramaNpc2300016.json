[
    {
        "TextId": 1,
        "ActorName": "Santi",
        "ActorTalk": "Something goes wrong right after work... What would you do in that situation?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "What happened?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "Off work.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Santi",
        "ActorTalk": "You know how this place is seen as Babylonia's go-to dating spot. And just now, the business lead had a moment of very poor judgment...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Santi",
        "ActorTalk": "They want us working overtime to grow eight-leaf clovers just for dates.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "Is that even possible?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Santi",
        "ActorTalk": "It's doable. With our lab conditions, even ten leaves wouldn't be a problem. It just had to be tonight, though...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Santi",
        "ActorTalk": "So now they want a fast-growing variety too? Are they trying to turn clovers into bean sprouts or chives?!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Santi",
        "ActorTalk": "I feel the same. My niece finally came to visit... I can't let her down.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Santi",
        "ActorTalk": "So, Commandant of Gray Raven, can I leave the rest to you?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "Sorry, I've got something else to handle.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "You should always finish your own work.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Santi",
        "ActorTalk": "Wait, what?",
        "Cv": null,
        "Desc": null
    }
]