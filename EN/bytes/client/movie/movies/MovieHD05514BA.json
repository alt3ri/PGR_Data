        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Lucia pauses for a moment before smiling. She can accept this feeling now, and she feels the same in this moment.'}"
    },
    {
        "Id": 75,
        "ActionId": 75,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"In Lucia's eyes, that same warm sunlight falls on her own treasure, and she finds herself unable to look away.\"}"
    },
    {
        "Id": 76,
        "ActionId": 76,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Lucia', 3: \"You're right, Commandant. Perhaps I never needed to go look for something else. Everything I've ever wanted and longed for has always been right here beside me.\", 4: '1'}"
    },
    {
        "Id": 77,
        "ActionId": 77,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Lucia', 3: 'The prize of this game might turn out to be something wonderful... but compared to something ethereal like that...', 4: '1'}"
    },
    {
        "Id": 78,
        "ActionId": 78,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Lucia', 3: 'Getting to hold your hand, being here with you, sharing this quiet moment together... No prize in the world can compare.', 4: '1'}"
    },
    {
        "Id": 79,
        "ActionId": 79,
        "NextActionId": null,
        "Type": 202,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
