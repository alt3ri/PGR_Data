        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Lucia glances toward a clearing not far off with a shallow pond. She has passed through it with you once before, but you two never got to take it in properly.'}"
    },
    {
        "Id": 91,
        "ActionId": 91,
        "NextActionId": null,
