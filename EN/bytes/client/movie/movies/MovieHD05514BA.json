        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Lucia', 3: 'It doesn\\'t matter if we arrived early or late. What matters is that neither of us missed it... the chance to become each other\\'s \"treasure.\"', 4: '1'}"
    },
    {
        "Id": 93,
        "ActionId": 93,
