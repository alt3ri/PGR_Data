        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'It seems we were on the \"right\" path all along.', 3: '90', 4: 'A happy accident, all things considered.', 5: '90'}"
    },
