        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The chirping catches both of your attention. One of the birds has left its perch and fluttered down to the ground, pecking curiously at the blindfold. Picking it up, Lucia finds a small note tucked inside.'}"
    },
    {
        "Id": 83,
        "ActionId": 83,
        "NextActionId": null,
        "Type": 307,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '\"Now, turn and look at the companion beside you. Congratulations! You\\'ve found the most precious treasure in this game.\"', 2: '0'}"
    },
