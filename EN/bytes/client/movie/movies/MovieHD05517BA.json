        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'That song sounded like music from Kowloong?', 3: '31', 4: 'It had a vintage feel to it.', 5: '31'}"
    },
    {
        "Id": 31,
        "ActionId": 31,
        "NextActionId": null,
