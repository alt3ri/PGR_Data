        "ActionId": 125,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'She raises her hand, her fingertips brushing softly across your cheek and stopping at the curve of your jaw.'}"
    },
    {
        "Id": 125,
        "ActionId": 126,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: \"It seems that I was right... The Double Seventh Festival, and a rare night spent with you... Perhaps there's no better time to sing it.\", 4: '1'}"
    },
