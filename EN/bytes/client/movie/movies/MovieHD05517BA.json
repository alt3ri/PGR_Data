        "Params": "{2: 'Hanying', 3: \"And in terms of techniques, it's hard for me to find the right emotions for the song if I have nowhere to look.\", 4: '1'}"
    },
    {
        "Id": 65,
        "ActionId": 65,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'She hesitates, letting an uneasy silence stretch between you. Then, slowly, she looks up and lets her gaze rest on you.'}"
    },
    {
        "Id": 66,
        "ActionId": 66,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: '<size=35>...Besides, this song was always meant to be performed while looking at someone special.</size>', 4: '1'}"
    },
    {
        "Id": 67,
        "ActionId": 67,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: '...?', 3: '68', 4: 'Someone special?', 5: '68'}"
    },
    {
        "Id": 68,
        "ActionId": 68,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: 'After all, there are still so many things... hidden inside the lyrics.', 4: '1'}"
    },
    {
        "Id": 69,
        "ActionId": 69,
        "NextActionId": null,
