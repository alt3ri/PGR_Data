        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: \"I've listened to countless songs from the old world aboard the Nighter, but not one of them could quite say what I wanted to say.\", 4: '1'}"
    },
    {
        "Id": 122,
        "ActionId": 123,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: 'Your song has to be something special. I spent a long time writing it, but I never knew when the right moment was to sing it to you.', 4: '1'}"
    },
    {
        "Id": 123,
        "ActionId": 124,
        "NextActionId": null,
        "Type": 401,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '2', 2: '1543'}"
    },
