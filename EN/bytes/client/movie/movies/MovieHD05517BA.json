        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'She turns and looks at you longingly, the silk across her shoulders lifting up with the motion, then falling still.'}"
