        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The words come haltingly at first, but her voice grows smoother as she settles in. Eventually, she crosses the stage toward you mid-song, taking your hand with unhurried grace.'}"
    },
    {
        "Id": 83,
        "ActionId": 83,
