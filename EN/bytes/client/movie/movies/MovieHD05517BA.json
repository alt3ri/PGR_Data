        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Those eyes, which were cast downward only moments ago, now contain the dazzling neon, the dreamy glow of the stage, and your silhouette.'}"
    },
