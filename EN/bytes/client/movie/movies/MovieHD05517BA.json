        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Hanying', 3: \"You're a bit too far away... but I'll give it a try.\", 4: '1'}"
    },
