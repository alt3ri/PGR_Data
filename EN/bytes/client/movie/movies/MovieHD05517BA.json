        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'A few seconds pass. She raises the microphone again and begins, her voice barely above a whisper.'}"
    },
    {
