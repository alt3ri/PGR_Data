        "Id": 99,
        "ActionId": 100,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The neon traces her silhouette in liquid gold, and the velvet curtains drape behind her like a crimson nightfall. Again and again, she steps forward from the faded memory of Kowloong gracefully and longingly.'}"
    },
