        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The last note of her song fades away, and a smile follows in its place. Something flickers briefly in her eyes before she composes herself, leaving only the faintest blush on her cheeks.'}"
    },
    {
        "Id": 30,
        "ActionId": 30,
