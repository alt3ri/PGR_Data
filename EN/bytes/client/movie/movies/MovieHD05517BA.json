        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: \"It is indeed a Kowloong pop song from the Golden Age. To be more precise, it's a style that goes back several centuries before that.\", 4: '1'}"
    },
    {
        "Id": 32,
        "ActionId": 32,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: \"The guests always loved these old-style tunes back on the Nighter, but I haven't sung much since I left... Do you like it?\", 4: '1'}"
    },
    {
        "Id": 33,
        "ActionId": 33,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'It sounds wonderful. I like this kind of music.', 3: '34', 4: \"I'd like to hear more of it.\", 5: '35'}"
    },
    {
        "Id": 34,
        "ActionId": 34,
        "NextActionId": 36.0,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Hanying', 3: 'Thank you... Hearing that from you means a great deal. I feel much more at ease now.', 4: '1'}"
    },
