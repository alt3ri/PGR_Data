        "ActionId": 7,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"The gentle heat coaxes out the vegetables' natural sweetness, and a light, warm fragrance drifts over on the night breeze.\"}"
    },
    {
