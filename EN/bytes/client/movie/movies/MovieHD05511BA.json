        "IsEnd": 1.0,
        "BeginAnim": null,
        "EndAnim": "AniZhuanchangBegin",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Time no longer rushes forward like a river. It unfolds quietly in the firelight, gently enveloping this moment.'}"
