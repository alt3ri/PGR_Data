        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Everything slows to an almost luxurious pace. The fire burns quietly between you, accompanied only by the sound of steady breathing and the occasional soft crackle from the coals.'}"
    },
