        "Id": 56,
        "ActionId": 56,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Gradually, the rest of the skewers are done cooking. Watanabe places them on your plate without a word.'}"
    },
    {
        "Id": 57,
