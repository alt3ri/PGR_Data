        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The cut edges of the vegetables brown over the slow flame, their juices dripping into the coals with a soft hiss.'}"
    },
    {
