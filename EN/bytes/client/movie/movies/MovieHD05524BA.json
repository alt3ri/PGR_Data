        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'You are playing a game with a delicate structure built from playing cards. Sophia and you take turns adding a card to it, and whoever sends it tumbling down loses.'}"
