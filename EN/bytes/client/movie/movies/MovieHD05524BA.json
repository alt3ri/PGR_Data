        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 3: 'Sophia sits across the table, her mechanical arm propped beneath her chin. Her eyes are fixed on the elaborate house of cards between you.'}"
