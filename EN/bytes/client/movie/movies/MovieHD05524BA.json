        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sophia', 3: \"Your turn, Commandant. Friendly reminder: don't hesitate. The more you do, the more your hand shakes.\", 4: '1'}"
