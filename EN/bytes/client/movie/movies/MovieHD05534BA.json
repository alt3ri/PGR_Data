        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'A few simple water lanterns are drifting down the canal, one after another.'}"
    },
    {
        "Id": 8,
        "ActionId": 8,
