        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Doorman', 3: 'A Lady \u3010kuroname\u3011 came through with this very invitation half an hour ago. She wore a very beautiful black dress.', 4: '1'}"
