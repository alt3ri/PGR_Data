        "Params": "{3: '!!!'}"
    },
    {
        "Id": 94,
        "ActionId": 94,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'A shrill neigh interrupts your conversation, and your horse suddenly grinds to a halt. No matter how much coaxing it receives, the animal refuses to take another step.'}"
    },
    {
        "Id": 95,
        "ActionId": 95,
        "NextActionId": null,
        "Type": 501,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
