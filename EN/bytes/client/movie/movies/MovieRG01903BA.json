        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": 2000.0,
        "Params": "{1: 'Assets/Product/Texture/Image/BgCg/Cg6601_2.jpg'}"
    },
    {
        "Id": 99,
        "ActionId": 99,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"\u3010kuroname\u3011! Be careful. Stay put... Let me check what's wrong.\"}"
    },
    {
        "Id": 100,
        "ActionId": 100,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Kamui dismounts swiftly to examine the horse. Within moments, he has calmed the animal down, keeping it from getting spooked again and hurting its rider.'}"
    },
    {
        "Id": 101,
        "ActionId": 101,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"...It has an old injury on its leg. The walk must've aggravated it.\"}"
    },
    {
        "Id": 102,
        "ActionId": 102,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"The dealer must've known and kept quiet about it. That's why this one was going for so cheap.\"}"
    },
    {
        "Id": 103,
        "ActionId": 103,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: \"...Shouldn't have gone for the bargain deal.\", 3: '104', 4: '...Poor horse.', 5: '104'}"
    },
    {
        "Id": 104,
        "ActionId": 104,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"For the horse's sake and your safety, we shouldn't keep riding it.\"}"
    },
    {
        "Id": 105,
        "ActionId": 105,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"But we've come too far to turn back now, which means...\"}"
    },
    {
        "Id": 106,
        "ActionId": 106,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: 'You can ride with me on my Hunter-certified steed instead!'}"
    },
    {
        "Id": 107,
        "ActionId": 107,
        "NextActionId": null,
        "Type": 104,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '0|-50|-100', 2: '1'}"
    },
    {
        "Id": 108,
        "ActionId": 108,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"Kamui swings onto his horse with practiced ease, steadying the animal with a few expert motions. Once satisfied it's calm, he reaches down toward you.\"}"
    },
    {
        "Id": 109,
        "ActionId": 109,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: 'My esteemed Detective \u3010kuroname\u3011, might I have the honor of inviting you to share my ride?'}"
    },
    {
        "Id": 110,
        "ActionId": 110,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"Don't worry! The Revenant Hunter's riding skills are second to none. I guarantee you a smooth, comfortable trip!\"}"
    },
    {
        "Id": 111,
        "ActionId": 111,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: \"(Take Kamui's hand)\", 3: '112', 4: '(Wait for Kamui to pull you up)', 5: '112'}"
    },
    {
        "Id": 112,
        "ActionId": 112,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: 'Three, two, one\u2014up we go!'}"
    },
    {
        "Id": 113,
        "ActionId": 113,
        "NextActionId": null,
        "Type": 401,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '2', 2: '13081710'}"
    },
    {
        "Id": 114,
        "ActionId": 114,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"Kamui lifts you onto the horse gently. Only after you're settled securely in the saddle does he take the reins.\"}"
    },
    {
        "Id": 115,
        "ActionId": 115,
        "NextActionId": null,
        "Type": 401,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '2', 2: '5713'}"
    },
    {
        "Id": 116,
        "ActionId": 116,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Unlike how fast he would normally ride on his own, Kamui keeps the horse moving at a steady pace, seemingly looking after you.'}"
    },
    {
        "Id": 117,
        "ActionId": 117,
        "NextActionId": null,
        "Type": 104,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '-50|-115|-200', 2: '3'}"
    },
    {
        "Id": 118,
        "ActionId": 118,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"Not bad, right? But let me know if you're uncomfortable!\"}"
    },
    {
        "Id": 119,
        "ActionId": 119,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"This is actually my first time riding with someone else\u2014and it's pretty nice! I don't think we need to get you a new horse anymore, \u3010kuroname\u3011. We can just share this one!\"}"
    },
    {
        "Id": 120,
        "ActionId": 120,
        "NextActionId": null,
        "Type": 402,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '5713'}"
    },
    {
        "Id": 121,
        "ActionId": 121,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sure, but I get to sit in front next time.', 3: '122', 4: \"Then you can take the reins from now on. I'll relax in the back.\", 5: '122'}"
    },
    {
        "Id": 122,
        "ActionId": 122,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: \"Yes, yes, of course! As long as you promise to stay with me, I'll agree to anything!!\"}"
    },
    {
        "Id": 123,
        "ActionId": 123,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Where do we go next?', 3: '124'}"
    },
    {
        "Id": 124,
        "ActionId": 124,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Kamui', 3: 'What happened with Hadrian got me thinking about something, so I thought maybe I should...'}"
    },
    {
        "Id": 125,
        "ActionId": 125,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
