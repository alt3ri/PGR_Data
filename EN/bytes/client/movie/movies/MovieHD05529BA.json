        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Teddy', 3: 'I dug up the archived footage of these fireworks from an ancient server, then spent a bit of time rebuilding the models so they can play out in this little space.', 4: '1'}"
    },
