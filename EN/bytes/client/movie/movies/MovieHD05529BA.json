        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'She turns to look at you, her profile still bathed in the lingering glow of the fireworks. She smiles, waiting for that look of delighted surprise on your face.'}"
