        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Nirvatia', 3: \"The Velosenne family serves as executioners. Their duty is to personally put down any who break the taboos or defy the clan's laws.\", 4: '1'}"
    },
