        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Having completed a mission, you were resting at a nearby conservation area earlier today when this refugee showed up. Claiming that an Ascendant had been spotted near his home, he sought help from the renowned commandant.'}"
