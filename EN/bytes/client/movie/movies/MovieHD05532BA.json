        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": "DialogEnable",
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Discord', 3: 'After reading about the Kowloong legends surrounding the Double Seventh Festival, I spent the last few days creating something I wanted to give you, Commandant.', 4: '1'}"
    },
