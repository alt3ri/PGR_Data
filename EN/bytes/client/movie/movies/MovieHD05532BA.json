        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Discord', 3: \"Traditional origami doesn't allow for any cutting. I haven't quite mastered that technique yet.\", 4: '1'}"
    },
