        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Discord', 3: 'But the piece is rather large and difficult to move, which was why I asked you to come see it in person, Commandant.', 4: '1'}"
    },
