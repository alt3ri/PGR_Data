        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Discord', 3: \"With enough thought and care in the design, a single sheet of paper can be folded into any polyhedron you can imagine. It's a truly elegant art form.\", 4: '1'}"
    },
    {
        "Id": 30,
        "ActionId": 30,
        "NextActionId": null,
        "Type": 302,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: \"It's been mathematically proven for quite a while now.\", 3: '31', 4: \"Oh? I didn't know that. How interesting.\", 5: '31'}"
    },
    {
        "Id": 31,
        "ActionId": 31,
