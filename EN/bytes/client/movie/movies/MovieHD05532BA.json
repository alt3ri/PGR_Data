        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The figure clad in power armor on the left is unmistakably you, while the one on the right has familiar blue hair and wears a traditional azure gown. She looks like a celestial maiden that has descended from the heavens.'}"
    },
    {
        "Id": 44,
