        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Haicma', 3: 'As a side note, the time we spend together each year is even shorter. Following their model, if we were to meet at the same frequency, we would need to date for 3134 years to match their total time together.', 4: '1'}"
