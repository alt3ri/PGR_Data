        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'How old were the Cowherd and the Weaver Girl when they first met?', 3: '18', 4: 'When did the protagonists get together?', 5: '18'}"
    },
    {
        "Id": 18,
        "ActionId": 18,
