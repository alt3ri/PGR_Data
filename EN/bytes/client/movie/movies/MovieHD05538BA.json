        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Haicma', 3: 'I have cross-referenced the earliest surviving texts with later versions of the tale, and their ages were never explicitly recorded. However, drawing from folklore studies, they were likely between 16 and 20 in human age.', 4: '1'}"
    },
    {
        "Id": 20,
        "ActionId": 20,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Haicma', 3: 'However, as a mortal and a celestial maiden, their actual Activation Dates likely predated that by a lot. On a cosmic time scale, their romance has already spanned over 2000 Earth years.', 4: '1'}"
    },
    {
        "Id": 21,
        "ActionId": 21,
