        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Haicma', 3: 'That is not correct. The book is not hidden. It is simply placed in a non-public area according to special classification protocols. Access permissions are currently restricted.', 4: '1'}"
