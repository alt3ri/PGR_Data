        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: \"So it's a banned book?\", 3: '71', 4: \"So it's the kind of book I can't read?\", 5: '71'}"
