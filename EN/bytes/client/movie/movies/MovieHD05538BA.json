        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Haicma', 3: 'But if we account for their annual meetings on the magpie bridge, with each encounter averaging less than 24 hours, the total time they spent together after 2000 years did not even match a single human lifespan...', 4: '1'}"
    },
