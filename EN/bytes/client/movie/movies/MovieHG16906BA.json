        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"The first officer quickly reports the remaining ammunition, fuel consumption, and hull damage across the fleet. The situation isn't ideal, but it's still manageable. With the supplies transferred from Gray, defeating the pirates won't be a problem.\"}"
    },
    {
        "Id": 41,
        "ActionId": 41,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": "DialogDisable",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"But victory isn't what Adelyde cares about. She's here as an instructor overseeing a supplemental simulation. Her priority is keeping that student alive.\"}"
    },
    {
        "Id": 42,
        "ActionId": 42,
        "NextActionId": null,
        "Type": 310,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: \"Adelyde is an instructor, but she's also someone who values talent. She's already seen how exceptional this student is. Losing them to neurological damage from a simulated death would be an unacceptable waste.\", 2: '3', 5: '1'}"
    },
    {
        "Id": 43,
        "ActionId": 43,
        "NextActionId": null,
        "Type": 310,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: 'She once heard of a student who pushed through a dangerous training session, suffered severe damage to their consciousness, and lost the chance to become a commandant.', 2: '3'}"
    },
    {
        "Id": 44,
        "ActionId": 44,
        "NextActionId": null,
        "Type": 310,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: \"This exercise isn't a connection test, and the official system includes safeguards, but Adelyde still refuses to let the student take that risk.\", 2: '2'}"
    },
