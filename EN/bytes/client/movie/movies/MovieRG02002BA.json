        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: 'Wanna guess how much the bounty is? Enough to fix up six doors!', 4: '1'}"
    },
    {
        "Id": 37,
        "ActionId": 37,
        "NextActionId": null,
        "Type": 204,
        "IsBlock": null,
