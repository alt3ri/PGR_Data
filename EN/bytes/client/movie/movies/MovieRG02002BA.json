        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 3: 'Eileena barges in, holding a warm sandwich in her arms.'}"
    },
    {
        "Id": 15,
        "ActionId": 15,
