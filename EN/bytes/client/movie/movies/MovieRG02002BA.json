        "ActionId": 52,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: \"It's probably just stories cooked up by those who couldn't catch her and couldn't swallow their pride, if you ask me. It's easier to paint her as a monster than to admit she's been running circles around them.\", 4: '1'}"
    },
    {
