        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: 'No\u2014enough to tear this place down, rebuild it from scratch, and hire a private chef to make me steak sandwiches every single day!', 4: '1'}"
