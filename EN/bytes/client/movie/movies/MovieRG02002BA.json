        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: \"One day you'll pass out from hunger in there, and I won't even be able to open the door! I'll have to dig your grave!\", 4: '1'}"
