        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: 'But your clue card only says she was out shopping with a pretty lady, and that she bought a flower.', 4: '1'}"
    },
