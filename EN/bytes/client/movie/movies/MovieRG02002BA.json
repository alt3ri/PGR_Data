        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Eileena shrugs and grabs an apple, wiping it with her sleeve and taking a bite.'}"
    },
    {
        "Id": 43,
        "ActionId": 43,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: \"She's got quite the nerve, though. The whole city's after her, and she's still out here socializing like it's nothing: watching an opera with a duchess today, dancing with some rich lady tomorrow.\", 4: '1'}"
    },
    {
        "Id": 44,
        "ActionId": 44,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Eileena', 3: \"And honestly? Who dares to touch her when she plants herself next to these powerful people? Lay a finger on her, and you're making an enemy of every great family she's rubbing elbows with.\", 4: '1'}"
    },
    {
        "Id": 45,
        "ActionId": 45,
        "NextActionId": null,
