        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The wall is covered in photographs, clippings, handwritten notes, cargo records, and court documents. Red strings crisscross between them, weaving an airtight web.'}"
