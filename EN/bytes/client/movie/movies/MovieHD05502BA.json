        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'She pours the hot water into the cup, turning the clear water into a faint shade of green. A light, lingering fragrance begins to rise.'}"
