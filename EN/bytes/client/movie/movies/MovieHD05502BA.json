        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'A breeze slips through the corridor, carrying the fresh, verdant scent of thriving greenery.'}"
    },
