        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'You draw your gaze from the flowers and trees to the small table before you, upon which sits a delicate white porcelain tea set.'}"
