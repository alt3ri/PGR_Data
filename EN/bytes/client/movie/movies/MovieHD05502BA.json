        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Qu accepts it, inhaling the fragrant steam with a gentle smile. But instead of drinking, she raises the cup to your lips.'}"
