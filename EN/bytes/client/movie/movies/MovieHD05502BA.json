        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Qu', 3: \"It's as if they hold within them a record of time passed, and the care of those who tended them.\", 4: '1'}"
