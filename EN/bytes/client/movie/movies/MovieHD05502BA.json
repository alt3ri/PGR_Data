        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Qu', 3: 'Even the most unassuming seedlings would grow into something remarkable day by day...', 4: '1'}"
