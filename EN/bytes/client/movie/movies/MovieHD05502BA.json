        "ActionId": 6,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The garden beyond the corridor is lush and verdant, while birdsong drifts through the air. The only people enjoying this tranquil sanctuary are the two of you.'}"
    },
    {
