        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Leia', 3: '...', 4: '1'}"
    },
    {
        "Id": 78,
        "ActionId": 78,
        "NextActionId": null,
        "Type": 203,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '0.25', 3: '-400'}"
    },
    {
        "Id": 79,
        "ActionId": 79,
        "NextActionId": null,
        "Type": 201,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '2', 2: '501290', 4: '400'}"
    },
    {
        "Id": 80,
        "ActionId": 80,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Sylph', 3: \"Leia, our people just finished sweeping the freighters. Just like we suspected, it's loaded with Ytterbium-174.\", 4: '2'}"
    },
    {
        "Id": 81,
        "ActionId": 81,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: 'It was one of the materials used to develop Construct Tech back in the day, though it was eventually replaced by Tantalum-193... We need to find out why the Ascendant is collecting it.', 4: '2'}"
    },
    {
        "Id": 82,
        "ActionId": 82,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Leia', 3: 'Sylph... Mr. Jorge has passed.', 4: '1'}"
    },
    {
        "Id": 83,
        "ActionId": 83,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'Sylph gives a small nod at the news with neither surprise nor grief, as if she has seen this coming all along.'}"
    },
    {
        "Id": 84,
        "ActionId": 84,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: \"I know. I'll look into what he mentioned myself... but the data on one terminal isn't enough to wipe out all the darkness in the world.\", 4: '2'}"
    },
    {
        "Id": 85,
        "ActionId": 85,
        "NextActionId": null,
        "Type": 204,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '12'}"
    },
    {
        "Id": 86,
        "ActionId": 86,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Leia', 3: \"Are you saying he didn't know enough?\", 4: '1'}"
    },
    {
        "Id": 87,
        "ActionId": 87,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: \"I'm afraid so, and he probably knew even less than Amazigh did. I have no interest in condemning a dead man, but if he truly understood what he was doing...\", 4: '2'}"
    },
    {
        "Id": 88,
        "ActionId": 88,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: 'He should have exposed everything before he worked with the Ascendant and those corrupt officials.', 4: '2'}"
    },
    {
        "Id": 89,
        "ActionId": 89,
        "NextActionId": null,
        "Type": 204,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '14'}"
    },
    {
        "Id": 90,
        "ActionId": 90,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Leia', 3: 'But then he never could have saved Kronos and the others...', 4: '1'}"
    },
    {
        "Id": 91,
        "ActionId": 91,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: 'He believed he was doing good, but you and I both know that he committed an unforgivable sin.', 4: '2'}"
    },
    {
        "Id": 92,
        "ActionId": 92,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: \"Leia, what's right and what's wrong... it's not something I'm equipped to judge.\", 4: '2'}"
    },
    {
        "Id": 93,
        "ActionId": 93,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: \"That's why I joined the Purifying Force and became a Construct that hunts nothing but sin and darkness.\", 4: '2'}"
    },
    {
        "Id": 94,
        "ActionId": 94,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Sylph', 3: \"Exterminating sin and darkness is so much simpler than trying to untangle what's right and wrong in human nature.\", 4: '2'}"
    },
    {
        "Id": 95,
        "ActionId": 95,
        "NextActionId": null,
        "Type": 202,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '2', 6: '1'}"
    },
    {
        "Id": 96,
        "ActionId": 96,
        "NextActionId": null,
        "Type": 201,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '501680', 3: '14'}"
    },
    {
        "Id": 97,
        "ActionId": 97,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 3: 'With that, Sylph turns and rejoins the cleanup crew, leaving Leia alone amid the wreckage.', 4: '2'}"
    },
    {
        "Id": 98,
        "ActionId": 98,
        "NextActionId": null,
        "Type": 202,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1'}"
    },
    {
        "Id": 99,
        "ActionId": 99,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The wildfire dies down at last. Scorched earth stretches in every direction, and the scattered remains of the Corrupted lie silent on the ground.'}"
    },
    {
        "Id": 100,
        "ActionId": 100,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'The slaughter and the flames have run their course, yet the weight of it all lingers, like a shadow that refuses to lift.'}"
    },
    {
        "Id": 101,
        "ActionId": 101,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'In the wake of everything that has happened, Leia finds herself truly questioning what it means to keep running headlong into battle, again and again.'}"
    },
    {
        "Id": 102,
        "ActionId": 102,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: \"She wrestles with it, then shakes her head. No answers come; just Sylph's parting words about good and evil are enough to give her a headache.\"}"
    },
    {
        "Id": 103,
        "ActionId": 103,
        "NextActionId": null,
        "Type": 201,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '501680', 3: '8'}"
    },
    {
        "Id": 104,
        "ActionId": 104,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Leia', 3: \"I don't understand...\", 4: '1'}"
    },
    {
        "Id": 105,
        "ActionId": 105,
        "NextActionId": null,
        "Type": 202,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1'}"
    },
    {
        "Id": 106,
        "ActionId": 106,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{3: 'A breeze sweeps across the scorched earth, scattering the ash. She looks up at the clear sky beyond, and she reaches out\u2014'}"
    },
    {
        "Id": 107,
        "ActionId": 107,
        "NextActionId": null,
        "Type": 201,
        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: '501680', 3: '4'}"
    },
    {
        "Id": 108,
        "ActionId": 108,
        "NextActionId": null,
        "Type": 301,
        "IsBlock": null,
        "IsEnd": 1.0,
        "BeginAnim": null,
        "EndAnim": "AniZhuanchangBegin",
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{1: '1', 2: 'Leia', 3: \"But at least... I don't want to live in a world where being kind makes you weak.\", 4: '1'}"
    }
