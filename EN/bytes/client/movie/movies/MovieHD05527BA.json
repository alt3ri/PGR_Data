        "IsBlock": null,
        "IsEnd": null,
        "BeginAnim": null,
        "EndAnim": null,
        "BeginDelay": null,
        "EndDelay": null,
        "Params": "{2: 'Luna', 3: \"It was a silly story. A group of monkeys spotted the moon's reflection in a well and mistook it for the real moon, so they chained themselves together and hung upside down, trying to fish it out.\", 4: '1'}"
    },
    {
