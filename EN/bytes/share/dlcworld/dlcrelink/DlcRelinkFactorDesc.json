    {
        "Id": 31001,
        "AttributeName": null,
        "AttributeType": 1,
        "LevelOverlyingType": 2,
        "DetailShowType": 3,
        "Name": "Thunder Brand (Unique)",
        "Desc": "\u3010\u6df1\u7ea2\u56da\u5f71\u00b7\u77ac\u5f71\u94c1\u9a91\u3011\u7684\u3010\u71ce\u8352\u65a9\u3011\u3001\u3010\u5f71\u88ad\u3011\u548c\u3010\u632f\u96f7\u65a9\u3011\u83b7\u5f97<color=#ffdd93>\u4f24\u5bb3\u52a0\u6210</color>\u3002\u3010\u9732\u897f\u4e9a\u00b7\u6df1\u7ea2\u56da\u5f71\u3011\u7684\u653b\u51fb\u6709\u6982\u7387\u7ed9\u654c\u4eba\u7559\u4e0b\u3010\u4f24\u75d5\u3011\uff0c\u3010\u4f24\u75d5\u3011\u6700\u591a\u5b58\u57285\u4e2a\uff0c\u4f7f\u7528\u3010\u71ce\u8352\u65a9\u3011\u9020\u6210\u4f24\u5bb3\u65f6\uff0c\u4f1a\u5f15\u7206\u5168\u90e8\u3010\u4f24\u75d5\u3011\u964d\u4e0b<color=#ffdd93>\u843d\u96f7\u9020\u6210\u989d\u5916\u4f24\u5bb3</color>\u3002",
        "Icon": null,
        "IsPercent": null,
        "MaxLevel": 2,
        "Order": 1
    },
    {
        "Id": 31002,
        "AttributeName": null,
        "AttributeType": 1,
        "LevelOverlyingType": 2,
        "DetailShowType": 3,
        "Name": "Ashen Memory (Unique)",
        "Desc": "\u3010\u6df1\u7ea2\u56da\u5f71\u00b7\u8c10\u632f\u5203\u950b\u3011\u7684\u3010\u5251\u6c14\u3011\u4e0e\u3010\u5251\u6c14\u653b\u51fb\u3011\u83b7\u5f97<color=#ffdd93>\u4f24\u5bb3\u52a0\u6210</color>\uff0c\u91ca\u653e\u3010\u5251\u6c14\u653b\u51fb\u3011\u65f6\u4f1a\u6cbb\u7597\u81ea\u8eab1%\u6700\u5927\u751f\u547d\u503c\uff0c\u81ea\u8eab\u653b\u51fb\u547d\u4e2d\u5e26\u6709\u3010\u5251\u635f\u70d9\u5370\u3011\u7684\u76ee\u6807\u65f6\uff0c\u989d\u5916\u9020\u6210\u4e00\u6b21\u5251\u635f\u4f24\u5bb3\u4e14\u4e0d\u6d88\u8017\u3010\u5251\u635f\u70d9\u5370\u5c42\u6570\u3011\uff0c\u8be5\u6548\u679c\u6bcf0.5\u79d2\u6700\u591a\u89e6\u53d1\u4e00\u6b21\u3002",
        "Icon": null,
        "IsPercent": null,
        "MaxLevel": 2,
        "Order": 2
    },
