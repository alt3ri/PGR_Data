        "StageDetailTitle": "\u9057\u4f1a",
        "StageAttention": "['\u739b\u683c\u4e3d\u7279\u8df3\u8d77\uff0c\u8f6c\u52a8\u4e00\u5708\u5e76\u540c\u65f6\u4e3a\u81ea\u5df1\u7684\u6743\u6756\u84c4\u529b\uff1b\u5728\u84c4\u529b\u5b8c\u6210\u540e\uff0c\u739b\u683c\u4e3d\u7279\u5c06\u987a\u52bf\u5411\u8eab\u524d\u53d1\u51fa\u5149\u675f\u3002', '\u739b\u683c\u4e3d\u7279\u5c06\u80fd\u91cf\u6c47\u805a\u4e8e\u6743\u6756\u5c16\u7aef\uff0c\u5e76\u5bf9\u76ee\u6807\u8fdb\u884c\u653b\u51fb\uff1b\u5728\u65cb\u8f6c\u83b7\u5f97\u5347\u529b\u540e\u5c06\u8fdb\u884c\u4e00\u6b21\u66f4\u5f3a\u529b\u7684\u8ffd\u51fb\uff1b\u7136\u540e\u739b\u683c\u4e3d\u7279\u5c06\u722c\u5347\u9ad8\u5ea6\uff0c\u5e76\u7528\u529b\u4e0b\u7838\uff0c\u5c06\u80fd\u91cf\u5168\u90e8\u91ca\u653e\u4e8e\u653b\u51fb\u5904\uff0c\u5e76\u5728\u653b\u51fb\u5904\u7efd\u51fa\u6728\u8d28\u5c16\u523a\u3002', '\u739b\u683c\u4e3d\u7279\u540e\u64a4\uff0c\u4ee5\u83b7\u5f97\u8ddd\u79bb\u4f18\u52bf\uff0c\u5e76\u5728\u8df3\u8dc3\u81f3\u6700\u9ad8\u70b9\u5904\u5411\u76ee\u6807\u53d1\u5c04\u80fd\u91cf\u5149\u5f39\u3002', '\u739b\u683c\u4e3d\u7279\u7528\u80fd\u91cf\u5f3a\u5316\u7fc5\u8180\uff0c \u5e76\u5411\u76ee\u6807\u53d1\u52a8\u4e24\u6b21\u53ef\u4ee5\u62fc\u5200\u7684\u653b\u51fb\u3002\u739b\u683c\u4e3d\u7279\u7b2c\u4e00\u6b21\u5c06\u4ece\u5979\u7684\u53f3\u4fa7\u653b\u51fb\uff1b\u5728\u987a\u52bf\u65cb\u8f6c\u4e00\u5708\u540e\uff0c \u7b2c\u4e8c\u6b21\u5c06\u4ece\u5979\u7684\u5de6\u4fa7\u653b\u51fb\u3002\u5f53\u6210\u529f\u62fc\u5200\u62b5\u6321\u4f4f\u739b\u683c\u4e3d\u7279\u7684\u7b2c\u4e8c\u6b21\u653b\u51fb\u540e\uff0c \u739b\u683c\u4e3d\u7279\u5c06\u5229\u7528\u53cd\u4f5c\u7528\u529b\u987a\u52bf\u5411\u540e\u98de\u53bb\uff0c \u5e76\u5c04\u51fa\u80fd\u91cf\u5149\u5f39\u3002\u62fc\u5200\u62b5\u6321\u8fd9\u6b21\u653b\u51fb\u6210\u529f\u540e\uff0c\u4fbf\u53ef\u4ee5\u51fb\u5760\u739b\u683c\u4e3d\u7279\u3002', '\u739b\u683c\u4e3d\u7279\u8dc3\u8d77\uff0c \u5728\u7a7a\u4e2d\u77ed\u6682\u84c4\u529b\u540e\uff0c \u739b\u683c\u4e3d\u7279\u4f1a\u5c06\u80fd\u91cf\u84c4\u81f3\u81e