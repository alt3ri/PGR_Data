[
    {
        "Id": 1,
        "Text": "\u90a3\u6211\u5c31\u4e0d\u5ba2\u6c14\u5730\u6536\u4e0b\u5566\u3002"
    },
    {
        "Id": 2,
        "Text": "\u611f\u8c22\u6307\u6325\u5b98\u9601\u4e0b\u7684\u6177\u6168\u3002"
    },
    {
        "Id": 3,
        "Text": "\u5176\u5b9e\u4e0d\u5fc5\u5982\u6b64\u8d39\u5fc3\uff0c\u4e0d\u8fc7\uff0c\u8c22\u8c22\u3002"
    },
    {
        "Id": 4,
        "Text": "\u8c22\u8c22\uff0c\u6307\u6325\u5b98\u3002\u8ba9\u6211\u7ed9\u6307\u6325\u5b98\u505a\u70b9\u6599\u7406\uff0c\u4f5c\u4e3a\u6170\u52b3\u5427\u3002"
    },
    {
        "Id": 5,
        "Text": "\u597d\u5427\u2026\u2026\u6211\u59d1\u4e14\u6536\u4e0b\u3002"
    },
    {
        "Id": 6,
        "Text": "\u6309\u6211\u4eec\u7684\u5173\u7cfb\uff0c\u8fd9\u4e9b\u90fd\u662f\u591a\u4f59\u7684\u5ba2\u5957\u3002"
    },
    {
        "Id": 7,
        "Text": "\u5f88\u597d\uff0c\u65e2\u7136\u5982\u6b64\uff0c\u6211\u4f1a\u56de\u5e94\u4f60\u7684\u671f\u5f85\u2026\u2026\u4ee5\u4ee3\u884c\u8005\u7684\u65b9\u5f0f\u3002"
    },
    {
        "Id": 8,
        "Text": "\u8bf7\u5141\u8bb8\u6211\u90d1\u91cd\u9053\u8c22\uff0c\u6307\u6325\u5b98\u3002\u5e0c\u671b\u5728\u8fd9\u4e4b\u540e\u2026\u2026\u4f60\u80fd\u591f\u6536\u4e0b\u6211\u7684\u56de\u793c\u3002"
    },
    {
        "Id": 9,
        "Text": "\u563f\u563f\uff0c\u591a\u8c22\u5566\uff0c\u6307\u6325\u5b98\uff01"
    },
    {
        "Id": 10,
        "Text": "\u2026\u2026\u76f4\u89c9\u544a\u8bc9\u6211\uff0c\u8fd9\u4efd\u793c\u7269\u6709\u7740\u80fd\u6539\u53d8\u5384\u8fd0\u7684\u529b\u91cf\u3002\u8c22\u8c22\uff0c\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 11,
        "Text": "\u7ed9\u6211\u7684\u4e48\uff0c\u591a\u8c22\u5566\uff01"
    },
    {
        "Id": 12,
        "Text": "\u6307\u6325\u5b98\u771f\u4f1a\u8ba8\u5973\u5b69\u5b50\u6b22\u5fc3\u554a\uff0c\u662f\u5728\u671f\u5f85\u7740\u827e\u62c9\u7684\u4ec0\u4e48\u5462\uff1f"
    },
    {
        "Id": 13,
        "Text": "\u8c22\u8c22\uff0c \u6307\u6325\u5b98\u3002\u8fd9\u6837\u4e00\u6765\uff0c\u4e3d\u8299\u9700\u8981\u73cd\u89c6\u7684\u4e8b\u7269\uff0c\u53c8\u591a\u4e86\u4e00\u4ef6\u3002"
    },
    {
        "Id": 14,
        "Text": "\u8c22\u8c22\u2026\u2026\u770b\u6765\u4eca\u5929\u80fd\u505a\u4e2a\u597d\u68a6\u554a\u2026\u2026\u54c8\u3001\u554a\u2026\u2026Zzzzz\u2026\u2026"
    },
    {
        "Id": 15,
        "Text": "\u4e03\u5b9e\u6536\u4e0b\u4e86\u6307\u6325\u5b98\u7684\u793c\u7269\uff0c\u4e03\u5b9e\u7684\u597d\u611f\u5ea6\u4e0a\u5347\u5566\uff01"
    },
    {
        "Id": 16,
        "Text": "\u8c22\u8c22\u2026\u2026\u7070\u9e26\u7684\u6307\u6325\u5b98\uff0c\u56de\u793c\u8981\u9009\u4ec0\u4e48\u597d\u5462\uff1f"
    },
    {
        "Id": 17,
        "Text": "\u4ee5\u4e3a\u8fd9\u70b9\u4e1c\u897f\u5c31\u80fd\u6253\u53d1\u6211\u5417\uff1f\u4e0d\u591f\uff0c\u8fdc\u8fdc\u4e0d\u591f\uff0c\u6765\u4e3a\u6211\u732e\u4e0a\u66f4\u591a\uff0c\u6307\u6325\u5b98\uff01"
    },
    {
        "Id": 18,
        "Text": "\u4f60\u7684\u5fc3\u610f\uff0c\u5c31\u50cf\u56db\u6708\u56de\u6625\u7684\u85b0\u98ce\u4e00\u822c\u2026\u2026\u5728\u6211\u7684\u5fc3\u4e2d\u5439\u62c2\u7740\u3002"
    },
    {
        "Id": 19,
        "Text": "\u4e0d\u662f\u5403\u7684\u4e48\u2026\u2026\u4e0d\uff0c\u6ca1\u4ec0\u4e48\u3002"
    },
    {
        "Id": 20,
        "Text": "\u5f88\u597d\uff0c\u8fd9\u4e9b\u4e1c\u897f\uff0c\u5012\u522b\u6709\u4e00\u756a\u2018\u4ef7\u503c\u2019\u3002"
    },
    {
        "Id": 21,
        "Text": "\u5475\u5475\uff0c\u8fd9\u7b97\u662f\u89c2\u4f17\u7684\u6295\u8d4f\u4e48\u3002"
    },
    {
        "Id": 22,
        "Text": "\u55c5\u55c5\u2026\u2026\u5c0f\u5bb6\u4f19\u8bf4\u5b83\u60f3\u8981\u2026\u2026\u6240\u4ee5\uff0c21\u53f7\u5c31\u6536\u4e0b\u4e86\u3002"
    },
    {
        "Id": 23,
        "Text": "\u54df\uff0c\u8fd9\u662f\u7ed9\u6211\u7684\uff1f\u8c22\u5566\uff01\u8fd8\u6709\u5417\uff1f"
    },
    {
        "Id": 24,
        "Text": "\u8c22\u8c22\u6307\u6325\u5b98\u7684\u793c\u7269\uff0c\u84b2\u7262\u5f88\u611f\u6fc0\uff01"
    },
    {
        "Id": 25,
        "Text": "\u9884\u5b9a\u5916\u7684\u7269\u8d44\u63a5\u6536\u8bf7\u6c42\uff0c\u5224\u65ad\u2014\u2014\u540c\u610f\uff0c\u611f\u8c22\u60a8\u7684\u9988\u8d60\u3002"
    },
    {
        "Id": 26,
        "Text": "\u78a7\u513f\u80fd\u7528\u8fd9\u4e2a\u6765\u505a\u59dc\u997c\u4eba\u5417\u55f7\u545c\u3002"
    },
    {
        "Id": 27,
        "Text": "\u8c22\u5566\uff0c\u7070\u9e26\u7684\u6307\u6325\u5b98\u3002\u4f60\u4e5f\u8981\u73a9\u7684\u5f00\u5fc3\u54e6\u3002"
    }
]