    {
        "Id": 263,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8bfa\u514b\u63d0 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 264,
        "Text": "\u73a9\u6cd5\u83b7\u5f97"
    },
    {
        "Id": 265,
        "Text": "\u53c2\u4e0e\u4f0a\u7538\u6587\u5316\u7eaa\uff0c\u4e3a\u9009\u624b\u6295\u7968\u83b7\u5f97"
    },
    {
        "Id": 266,
        "Text": "\u6781\u57df\u534f\u4f5c\u5404\u699c\u5355\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 267,
        "Text": "\u6807\u51c6\u63a8\u6f14\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 268,
        "Text": "\u6781\u57df\u534f\u4f5c-\u6807\u51c6\u63a8\u6f14\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 269,
        "Text": "\u6545\u969c\u8fde\u643a\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 270,
        "Text": "\u6781\u57df\u534f\u4f5c-\u6545\u969c\u8fde\u643a\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 271,
        "Text": "\u9669\u8c61\u73af\u751f\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 272,
        "Text": "\u6781\u57df\u534f\u4f5c-\u9669\u8c61\u73af\u751f\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 273,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301850000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 274,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301800000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 275,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301750000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 276,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 277,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d1%~5%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 278,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d5%~10%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 279,
        "Text": "\u5b8c\u6210\u4e9a\u5361\u6570\u754c\u4efb\u52a1\u83b7\u5f97"
    },
    {
        "Id": 280,
        "Text": "\u901a\u8fc7\u636e\u70b9\u73a9\u6cd5\u83b7\u5f97"
    },
    {
        "Id": 281,
        "Text": "\u7d2f\u8ba1\u8d2d\u4e70{0}\u8679\u5361\u53ef\u83b7\u5f97"
    },
    {
        "Id": 282,
        "Text": "\u901a\u8fc7\u62df\u50cf\u8bd5\u70bc\u73a9\u6cd5\u83b7\u5f97"
    },
    {
        "Id": 283,
        "Text": "\u53c2\u4e0e\u795e\u5bc2\u542f\u793a\u5f55-\u4ea1\u547d\u6b7b\u7ade\uff0c\u8fbe\u5230\u6307\u5b9a\u6bb5\u4f4d\u540e\u83b7\u5f97"
    },
    {
        "Id": 284,
        "Text": "\u738b\u724c\u8f66\u624b"
    },
    {
        "Id": 285,
        "Text": "\u4e3a\u53c2\u4e0e\u661f\u95f4\u98de\u9a70\u7ade\u901f\u9884\u6d4b\u7684\u6307\u6325\u5b98\u4eec\u9881\u53d1\u7684\u7279\u522b\u8363\u8a89\u3002\u8bf7\u5c3d\u60c5\u4eab\u53d7\u8fd9\u573a\u5f15\u7206\u80be\u4e0a\u817a\u7d20\u7684\u72c2\u98d9\u76db\u5bb4\u5427\u3002"
    },
    {
        "Id": 286,
        "Text": "\u53c2\u4e0e\u661f\u95f4\u98de\u9a70\uff0c\u5728\u6781\u901f\u6d3e\u5bf9\u5185\u5151\u6362\u83b7\u5f97"
    },
    {
        "Id": 287,
        "Text": "\u6c38\u591c\u541b\u4e3b"
    },
    {
        "Id": 288,
        "Text": "\u5728\u795e\u660e\u5bc2\u706d\u540e\u7684\u4e16\u754c\uff0c\u9b54\u541b\u4ecd\u5b58\u3002"
    },
    {
        "Id": 289,
        "Text": "\u6536\u96c6\u300c\u79c1\u88c1\u00b7\u795e\u5bc2\u542f\u793a\u5f55\u300d\u7cfb\u5217\u5168\u90e8\u6d82\u88c5\u540e\u83b7\u5f97"
    },
    {
        "Id": 290,
        "Text": "\u8da3\u95fb\u63a2\u7d22\u8005"
    },
    {
        "Id": 291,
        "Text": "\u4ece\u77e5\u6167\u6e38\u5eca\u59cb\u6b65\uff0c\u884c\u81f3\u7199\u6518\u7684\u6e2f\u53e3\uff0c\u904d\u5386\u5176\u95f4\u9038\u95fb\u8da3\u4e8b\u7684\u63a2\u7d22\u8005\u4e4b\u8bc1\u3002"
    },
    {
        "Id": 292,
        "Text": "\u5b8c\u6210\u7a7a\u4e2d\u82b1\u56ed\u300c\u884c\u52a8\u6307\u5357\u2161\u300d\u4efb\u52a1\u6e05\u5355\u83b7\u53d6"
    },
    {
        "Id": 293,
        "Text": "\u6b32\u5ff5\u88c1\u6267"
    },
    {
        "Id": 294,
        "Text": "\u6d41\u91d1\u4e4b\u8680"
    },
    {
        "Id": 295,
        "Text": "\u7ec8\u4e34\u5929\u542f"
    },
    {
        "Id": 296,
        "Text": "\u73b0\u5728\uff0c\u7531\u6211\u6765\u4e3a\u4e16\u95f4\u4e00\u5207\u6b32\u671b\u79f0\u91cd\u3001\u5b9a\u4ef7\u3002"
    },
    {
        "Id": 297,
        "Text": "\u770b\u5450\uff0c\u5c31\u8fde\u90a3\u9ec4\u91d1\u7684\u6d2a\u6d41\u4e5f\u5728\u6b64\u523b\u4e3a\u6211\u51dd\u56fa\uff0c\u65cb\u5373\u4fbf\u88ab\u541e\u5165\u8179\u4e2d\u3002"
    },
    {
        "Id": 298,
        "Text": "\u5723\u949f\u54cd\u5f7b\u81f3\u9ad8\u5929\uff0c\u88c1\u51b3\u7684\u5929\u79e4\u5df2\u7136\u5c31\u4f4d\u3002\u4f46\u8fd9\u4e00\u6b21\uff0c\u88ab\u63a8\u4e0a\u5ba1\u5224\u5e2d\u7684\uff0c\u5c06\u662f\u795e\u660e\u81ea\u8eab\u3002"
    }
]