    {
        "Id": 152101106,
        "CvId": 152101,
        "Cvs": 1,
        "Timing": 27282.0,
        "Text": "I've rehearsed this scene... countless times in my heart,"
    },
    {
        "Id": 152101107,
        "CvId": 152101,
        "Cvs": 1,
        "Timing": 33813.0,
        "Text": "yet as I step into this grand hall... and hear the bells chime, my heart still flutters."
    },
    {
        "Id": 152101108,
        "CvId": 152101,
        "Cvs": 1,
        "Timing": 41526.0,
        "Text": "I believe it's because... you're standing right here... before me."
    },
    {
        "Id": 152101109,
        "CvId": 152101,
        "Cvs": 1,
        "Timing": 50034.0,
        "Text": "Through our days together... a myriad of... indescribable emotions... have gradually blossomed... right here in my heart."
    },
    {
        "Id": 152101110,
        "CvId": 152101,
        "Cvs": 1,
        "Timing": 63857.0,
        "Text": "Admiration, reliance, and trust..."
