[
    {
        "TextId": 1,
        "ActorName": "Vera",
        "ActorTalk": "Oh? So you really were looking forward to our little \"date\"!",
        "Cv": 510002323.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Vera",
        "ActorTalk": "Still playing it cool? Maybe I should've made you wait even longer.",
        "Cv": 510002324.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Vera",
        "ActorTalk": "You look like you're in a hurry. Looking for someone, Commandant?",
        "Cv": 510002321.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Vera",
        "ActorTalk": "Tell me, was there a moment you thought I'd stand you up? Leave you here all alone in the cold?",
        "Cv": 510002322.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Vera",
        "ActorTalk": "I've got to admit, the square's actually looking decent. Lots of grinning fools around. You've got a real talent for keeping them entertained.",
        "Cv": 510002325.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Vera",
        "ActorTalk": "But my standards are just a little bit higher than theirs.",
        "Cv": 510002326.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Vera",
        "ActorTalk": "I've been very busy lately. Had to turn down a good number of beatdowns and arrests just to make time for this.",
        "Cv": 510002327.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Vera",
        "ActorTalk": "I've been looking forward to this celebration. If it doesn't impress me, I'm afraid I'll have to give you a little \"punishment.\"",
        "Cv": 510002328.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Vera",
        "ActorTalk": "Hmm... Aren't you greedy.",
        "Cv": 510002329.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Vera",
        "ActorTalk": "Alright, if today's celebration meets my expectations, I'll give you a proper reward.",
        "Cv": 510002330.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Vera",
        "ActorTalk": "Then show me\u2014what brilliant idea does the famous Gray Raven Commandant have to entertain me?",
        "Cv": 510002331.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Vera...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "I'm looking for you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "Yes.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "No.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "Meaning...?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "\"Just a little bit\"?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "If there's punishment, does that mean there's a reward too?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": null,
        "ActorTalk": "Let's go then.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": null,
        "ActorTalk": "I'm confident you'll like it.",
        "Cv": null,
        "Desc": null
    }
]