        "ActorTalk": "...Commandant?",
        "Cv": 510000426.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "That voice... Lucia?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Lucia",
        "ActorTalk": "It's me. I'm right here. Are you okay, Commandant?",
        "Cv": 510000427.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I'm alright... just need a moment. Must've been out for a while.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Lucia",
        "ActorTalk": "Alright. Let me help you sit up.",
        "Cv": 510000428.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "......?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lucia",
        "ActorTalk": "While you were unconscious, it looked like you were having a nightmare.",
        "Cv": 510000429.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Lucia",
        "ActorTalk": "You kept frowning and saying my name over and over.",
        "Cv": 510000430.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "I thought, maybe this could help you feel a little better, so I\u2014",
        "Cv": 510000431.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "The last thing I remember is... the Dreamweaver world.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Right. The loop... are we still\u2014",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Lucia",
        "ActorTalk": "It's all over now, Commandant.",
        "Cv": 510000432.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "[PlayerName]",
        "ActorTalk": "This is... my lounge.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "Yes, that certainly helped.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "Maybe it was just instinct...",
        "Cv": null,
        "Desc": null
    }
