[
    {
        "TextId": 1,
        "ActorName": "Lucia",
        "ActorTalk": "Commandant.",
        "Cv": 510000095.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Lucia",
        "ActorTalk": "We're back now.",
        "Cv": 510000096.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Lucia",
        "ActorTalk": "\"Froggie's Day\"... I really liked how it ended.",
        "Cv": 510000097.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lucia",
        "ActorTalk": "As long as we hold onto kindness, resilience, and hope, even the biggest problems will be solved in the end. Everyone will find their own happiness.",
        "Cv": 510000098.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Lucia",
        "ActorTalk": "What did you think of the story, Commandant?",
        "Cv": 510000099.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Lucia",
        "ActorTalk": "...Commandant?",
        "Cv": 510000100.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lucia",
        "ActorTalk": "You've seemed distracted ever since we left the film world. Are you okay?",
        "Cv": 510000101.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Lucia",
        "ActorTalk": "The events we just experienced in the film... they were in your dream last night?",
        "Cv": 510000102.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "The projector's manual says it guides your consciousness while in use. Maybe that's what caused the illusion? Some people are more sensitive to it.",
        "Cv": 510000103.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lucia",
        "ActorTalk": "Let's find a place to rest. How about Kowloong Restaurant nearby? We can grab a bite and help you feel better.",
        "Cv": 510000104.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "It's possible.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "I'm not so sure.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "Yeah, let's take a break.",
        "Cv": null,
        "Desc": null
    }
]