[
    {
        "TextId": 1,
        "ActorName": null,
        "ActorTalk": "\u300a\u7ea2\u65cc\u00b7\u64a4\u79bb\u7eaa\u5143\u300b",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u8fd9\u5e45\u753b\u63cf\u7ed8\u4e86 \u201c\u5927\u64a4\u9000\u65f6\u4ee3\u201d \u7684\u7cbe\u795e\u5e95\u8272\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "\u753b\u9762\u4e2d\uff0c\u8eab\u62ab\u7ea2\u65cc\u7684\u6784\u9020\u4f53\u4e0e\u4eba\u7c7b\u6218\u58eb\u5e76\u80a9\u77d7\u7acb\u2014\u2014\u7ea2\u65cc\u65e2\u662f\u64a4\u79bb\u5e0c\u671b\u7684\u65d7\u5e1c\uff0c\u4e5f\u662f\u727a\u7272\u7cbe\u795e\u7684\u70d9\u5370\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "\u80cc\u666f\u7684\u6591\u9a73\u8d28\u611f\u662f\u65f6\u4ee3\u7684\u5177\u8c61\u5316\uff1a\u7070\u8c03\u662f\u88ab\u5e15\u5f25\u4ec0\u4fb5\u8680\u7684\u5730\u7403\u5e9f\u589f\u4f59\u70ec\uff0c\u6591\u6593\u6742\u8272\u5219\u662f\u4eba\u7c7b\u524d\u5f80\u7a7a\u4e2d\u82b1\u56ed\u7684\u98de\u884c\u5668\u5c3e\u7130\u3001\u6323\u624e\u706f\u706b\u7684\u7cc5\u5408\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "\u5b83\u8bb0\u5f55\u7684\u662f \u201c\u5927\u64a4\u9000\u201d \u4e2d\u6700\u60b2\u58ee\u7684 \u201c\u65ad\u540e\u65f6\u523b\u201d\u2014\u2014\u6784\u9020\u4f53\u4e0e\u4eba\u7c7b\u6218\u58eb\u4e00\u540c\u4e3a\u540c\u80de\u4e89\u53d6\u5b58\u7eed\u7684\u65f6\u95f4\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "\u7c97\u7c9d\u7684\u7b14\u89e6\u5982\u6218\u4e89\u4f24\u75d5\uff0c\u8272\u5f69\u7684\u51b2\u7a81\u91cc\u85cf\u7740\u4e24\u5c42\u5450\u558a\uff1a\u4e00\u662f\u5bf9\u5730\u7403\u5bb6\u56ed\u7684\u8840\u6cea\u544a\u522b\uff0c\u4e8c\u662f\u5411\u7a7a\u4e2d\u82b1\u56ed \u201c\u6587\u660e\u706b\u79cd\u5b58\u7eed\u201d \u7684\u5014\u5f3a\u5ba3\u8a93\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "\u6bcf\u4e00\u9053\u8272\u5757\u7684\u6495\u88c2\u611f\uff0c\u90fd\u662f\u5927\u64a4\u9000\u65f6\u4ee3 \u201c\u727a\u7272\u4e0e\u5b58\u7eed\u201d \u7684\u7f29\u5f71\u2014\u2014\u6211\u4eec\u79bb\u5f00\u4e86\u5730\u7403\uff0c\u4f46\u7ea2\u65cc\u6240\u6307\u7684\u7a7a\u4e2d\u82b1\u56ed\u65b9\u5411\uff0c\u662f\u4eba\u7c7b\u6587\u660e\u4e0d\u706d\u7684\u8bc1\u660e\u3002",
        "Cv": null,
        "Desc": null
    }
]