[
    {
        "TextId": 1,
        "ActorName": "Nervous Barista",
        "ActorTalk": "Welcome to Kuroro Coffee, what can I\u2014wait? Gray Raven Commandant!",
        "Cv": 510000114.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Nervous Barista",
        "ActorTalk": "It really is you! Manager Ross always talks about you. Says you make coffee like a pro. Never thought I'd meet you in person!",
        "Cv": 510000115.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Nervous Barista",
        "ActorTalk": "I just got my barista license. Making coffee in front of you? That's... a lot. But hey, we've got this interactive thing going on\u2014you can brew your own, try some latte art. Interested?",
        "Cv": 510000116.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lucia",
        "ActorTalk": "Maybe another time. Just looking to relax a bit right now.",
        "Cv": 510000117.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Nervous Barista",
        "ActorTalk": "O-okay... C'mon. Keep calm. Take a breath... W-what can I get for you?",
        "Cv": 510000118.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Lucia",
        "ActorTalk": "I'll have a Hazelnut Snow Latte with a clover design for the latte art. Commandant\u2014",
        "Cv": 510000119.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Nervous Barista",
        "ActorTalk": "One Hazelnut Snow, clover design, got it! Coming right up!",
        "Cv": 510000120.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Nervous Barista",
        "ActorTalk": "Clover, clover, clover... Here you go!",
        "Cv": 510000121.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "...",
        "Cv": 510000122.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "???",
        "ActorTalk": "...Foam's too thick...",
        "Cv": 510000123.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "(That voice again...)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Lucia",
        "ActorTalk": "Commandant...?",
        "Cv": 510000124.0,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Nervous Barista",
        "ActorTalk": "How did it end up like this? Oh no, I frothed the milk too much... I'm sorry! I'll make you a new one right away!",
        "Cv": 510000125.0,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Lucia",
        "ActorTalk": "...It's alright. This one's fine.",
        "Cv": 510000126.0,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Nervous Barista",
        "ActorTalk": "Really? Are you sure? Then, what about you, Gray Raven Commandant?",
        "Cv": 510000127.0,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Nervous Barista",
        "ActorTalk": "O-okay, just a moment... No mistakes this time! Please enjoy.",
        "Cv": 510000128.0,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "We're just here for a drink. No pressure.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "Still nervous, huh?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": null,
        "ActorTalk": "No rush. Take your time.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 20,
        "ActorName": null,
        "ActorTalk": "I'll have the same.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 21,
        "ActorName": null,
        "ActorTalk": "No latte art for me.",
        "Cv": null,
        "Desc": null
    }
]