        "ActorName": "Karenina",
        "ActorTalk": "Gray Raven Commandant\u2014hey, perfect timing. Take a seat.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Karenina",
        "ActorTalk": "This is a toy lie detector put together by an Engineering Force hobby group. It's actually pretty accurate.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Karenina",
        "ActorTalk": "For example, if I say...",
        "Cv": null,
        "Desc": null
    },
    {
