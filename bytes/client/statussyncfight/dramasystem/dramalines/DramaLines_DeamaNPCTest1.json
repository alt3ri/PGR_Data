    {
        "TextId": 7,
        "ActorName": "Karenina",
        "ActorTalk": "That means I'm telling the truth.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Karenina",
        "ActorTalk": "And... I haven't seen the Gray Raven Commandant today.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Was that the wrong sound?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": null,
        "ActorTalk": "(Sit down)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": null,
        "ActorTalk": "(Stay standing)",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Backtrack Test",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Karenina",
        "ActorTalk": "Yeah, just say anything.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Karenina",
        "ActorTalk": "Since you're already sitting, you're not allowed to leave! I'm not biting. Just say whatever comes to mind!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Karenina",
        "ActorTalk": "Heh, clever. They're planning to sell this later, and I just happen to need a guinea pig. You get what I mean.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "Want me to just say something random?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "But I refuse!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
