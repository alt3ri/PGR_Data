    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u201c\u4e07\u4e16\u94ed\u201d \u5e76\u975e\u7b80\u5355\u7684\u5efa\u7b51\uff0c\u800c\u662f\u4e5d\u9f99\u4e4b\u4e3b\u66f2\u4f9d\u6258AI \u201c\u534e\u80e5\u201d \u63a8\u884c\u7684\u6587\u660e\u5b58\u7eed\u8ba1\u5212\u2014\u2014\u5b83\u5c06\u4eba\u7c7b\u610f\u8bc6\u4ee5\u6570\u636e\u5f62\u5f0f\u5c01\u5b58\u4e8e\u865a\u62df\u7a7a\u95f4\uff0c\u8ba9\u6587\u660e\u5f97\u4ee5\u5728\u5e15\u5f25\u4ec0\u8086\u8650\u7684\u672b\u4e16\u4e2d \u201c\u6c38\u6052\u5b58\u5728\u201d\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "\u4e07\u4e16\u94ed\u7ed3\u6784\u672c\u8eab\u4e5d\u9f99\u4f20\u7edf\u5efa\u7b51\u4e0e\u79d1\u6280\u7684\u878d\u5408\u590d\u523b\uff1a\u98de\u6a90\u6597\u62f1\u7684\u5f62\u5236\u6e90\u81ea\u9ec4\u91d1\u65f6\u4ee3\u7684\u4e1c\u4e9a\u53e4\u5efa\uff0c\u91d1\u5c5e\u4e0e\u534a\u900f\u660e\u6750\u6599\u7684\u91cd\u6784\u5219\u662f\u672b\u4e16\u4e0b\u7684\u751f\u5b58\u667a\u6167\uff0c\u4fdd\u7559\u4e86 \u201c\u6a90\u89d2\u627f\u5929\u201d \u7684\u6587\u5316\u7b26\u53f7\u3002",
        "Cv": null,
        "Desc": null
    }
