    },
    {
        "TextId": 2,
        "ActorName": "\u533b\u751f",
        "ActorTalk": "\u8bf4\u5b9e\u8bdd\uff0c\u5f53\u7f57\u65af\u544a\u8bc9\u6211\u4ed6\u8bf7\u5230\u4e86\u7070\u9e26\u6307\u6325\u5b98\u65f6\uff0c\u6211\u8fd8\u4ee5\u4e3a\u81ea\u5df1\u542c\u9519\u4e86\u2026\u2026\u4f46\u4e0d\u7ba1\u600e\u6837\uff0c\u975e\u5e38\u611f\u8c22\u4f60\u613f\u610f\u63d0\u4f9b\u5e2e\u52a9\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "\u533b\u751f",
        "ActorTalk": "\u4e5f\u8bb8\u662f\u51fa\u4e8e\u4e0b\u610f\u8bc6\u7684\u81ea\u6211\u4fdd\u62a4\uff0c\u745e\u5a05\u5fd8\u4e86\u8bb8\u591a\u4e0e\u5730\u7403\u6709\u5173\u7684\u8bb0\u5fc6\u3002\u5982\u4eca\u5979\u9010\u6e10\u6062\u590d\u4e86\u7a33\u5b9a\uff0c\u6211\u60f3\u5c1d\u8bd5\u5e2e\u52a9\u5979\u91cd\u65b0\u60f3\u8d77\u90a3\u4e9b\u88ab\u9057\u5fd8\u7684\u7247\u6bb5\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "\u533b\u751f",
        "ActorTalk": "\u6cbb\u7597\u7684\u7b2c\u4e00\u6b65\u5c24\u4e3a\u5173\u952e\uff0c\u5b83\u4f1a\u76f4\u63a5\u5f71\u54cd\u540e\u7eed\u6cbb\u7597\u7684\u6548\u679c\u3002\u7136\u800c\uff0c\u745e\u5a05\u59cb\u7ec8\u96be\u4ee5\u5411\u6211\u655e\u5f00\u5fc3\u6249\uff0c\u8fd9\u53ef\u80fd\u4e0d\u5229\u4e8e\u7b2c\u4e00\u6b65\u7684\u987a\u5229\u8fc8\u51fa\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "\u533b\u751f",
        "ActorTalk": "\u76f8\u540c\u7684\u8eab\u4efd\u80fd\u591f\u5e26\u7ed9\u4eba\u4eb2\u8fd1\u611f\uff0c\u6240\u4ee5\uff0c\u6211\u5e0c\u671b\u5728\u6cbb\u7597\u7684\u8d77\u59cb\u9636\u6bb5\uff0c\u7531\u540c\u4e3a\u519b\u4eba\u7684\u4f60\u4e0e\u745e\u5a05\u4ea4\u6d41\u6c9f\u901a\uff0c\u5e2e\u52a9\u5979\u5bfb\u56de\u8bb0\u5fc6\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "\u533b\u751f",
        "ActorTalk": "\u5f53\u7136\uff0c\u524d\u63d0\u662f\u745e\u5a05\u5728\u4f60\u9762\u524d\u786e\u5b9e\u66f4\u52a0\u653e\u677e\u3002\u4f60\u53ef\u4ee5\u5148\u627e\u745e\u5a05\u968f\u610f\u804a\u804a\uff0c\u8bd5\u7740\u611f\u53d7\u4e00\u4e0b\u5979\u5bf9\u4f60\u7684\u63a5\u7eb3\u7a0b\u5ea6\u3002",
