[
    {
        "TextId": 1,
        "ActorName": null,
        "ActorTalk": "\u300a\u66d9\u5149\u4e09\u53f7?\u661f\u6d77\u8fdc\u5f81\u5fd7\u300b",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u827a\u672f\u8868\u73b0\uff1a\u4ee5 \u201c\u9ec4\u91d1\u65f6\u4ee3\u5b87\u5b99\u63a2\u7d22\u53f2\u8bd7\u201d \u4e3a\u521b\u4f5c\u6838\u5fc3\uff0c\u753b\u9762\u4e2d \u201c\u66d9\u5149\u4e09\u53f7\u201d \u98de\u884c\u5668\u5212\u7834\u661f\u73af\u7684\u5239\u90a3\u88ab\u5b9a\u683c\u4e3a\u6c38\u6052\u2014\u2014\u84dd\u7130\u5f15\u64ce\u6495\u88c2\u661f\u9645\u9634\u973e\uff0c\u91d1\u5c5e\u673a\u8eab\u5728\u661f\u4e91\u7684\u6591\u6593\u6655\u67d3\u4e2d\u6298\u5c04\u51fa\u51b7\u51bd\u7684\u79d1\u6280\u8d28\u611f\uff0c\u884c\u661f\u7684\u82cd\u52b2\u8f6e\u5ed3\u4e0e\u661f\u73af\u7684\u68a6\u5e7b\u7eb9\u7406\u78b0\u649e\uff0c\u5c06\u5199\u5b9e\u673a\u68b0\u7f8e\u5b66\u4e0e\u5370\u8c61\u6d3e\u5b87\u5b99\u7470\u4e3d\u611f\u7194\u4e8e\u4e00\u7089\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "\u610f\u4e49\u4e0e\u6545\u4e8b\uff1a\u5b83\u662f\u9ec4\u91d1\u65f6\u4ee3 \u201c\u661f\u6d77\u8fdc\u5f81\u68a6\u201d \u7684\u827a\u672f\u5177\u8c61\u3002\u5f7c\u65f6\u4eba\u7c7b\u5c1a\u672a\u88ab\u5e15\u5f25\u4ec0\u7684\u9634\u5f71\u7b3c\u7f69\uff0c\u4ee5 \u201c\u66d9\u5149\u4e09\u53f7\u201d \u4e3a\u4ee3\u8868\u7684\u63a2\u7d22\u8ba1\u5212\uff0c\u662f\u6587\u660e\u5bf9\u5b87\u5b99\u8fb9\u7586\u6700\u70bd\u70ed\u7684\u53e9\u95ee\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "\u8fd9\u5e45\u4f5c\u54c1\u91cc\uff0c\u98de\u884c\u5668\u7684\u6bcf\u4e00\u9053\u68f1\u7ebf\u90fd\u523b\u7740 \u201c\u4ee5\u661f\u4e3a\u9014\uff0c\u4ee5\u68a6\u4e3a\u9a6c\u201d \u7684\u51b3\u5fc3\u2014\u2014\u5373\u4fbf\u540e\u6765\u5730\u7403\u6ca6\u9677\uff0c\u8fd9\u4efd\u5bf9\u5b87\u5b99\u7684\u597d\u5947\u4ecd\u5982\u661f\u6838\u822c\u71c3\u70e7\uff1a\u5b83\u662f\u9ec4\u91d1\u65f6\u4ee3 \u201c\u6562\u628a\u661f\u6d77\u4f5c\u5766\u9014\u201d \u7684\u52cb\u7ae0\u3002",
        "Cv": null,
        "Desc": null
    }
]