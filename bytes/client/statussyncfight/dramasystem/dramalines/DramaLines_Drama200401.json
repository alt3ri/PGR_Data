[
    {
        "TextId": 1,
        "ActorName": "Lucia",
        "ActorTalk": "There you are, Commandant.",
        "Cv": 510002285.0,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "Lucia",
        "ActorTalk": "I was... observing people's expressions.",
        "Cv": 510002286.0,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Lucia",
        "ActorTalk": "Yes. Look, Commandant. Some are families who came together, and others are tourists here on their own.",
        "Cv": 510002287.0,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Lucia",
        "ActorTalk": "Constructs, humans, even mechanoids... they all seem to be caught up in the lively atmosphere. You can see it in their smiles.",
        "Cv": 510002288.0,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "Lucia",
        "ActorTalk": "Am I...? Maybe I got swept up in the celebration too, without even realizing it.",
        "Cv": 510002289.0,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Lucia",
        "ActorTalk": "Not long ago, this square was just a quiet, empty street. It's only because of you, and everyone's efforts, that it's been brought back to life like this.",
        "Cv": 510002290.0,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Lucia",
        "ActorTalk": "This may not be a battlefield, but I know there are still enemies hiding in the shadows. So every smile here... it's well-earned.",
        "Cv": 510002291.0,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Lucia",
        "ActorTalk": "You've worked hard lately, Commandant.",
        "Cv": 510002292.0,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "Lucia",
        "ActorTalk": "Will you take a walk with me, Commandant?",
        "Cv": 510002293.0,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Lucia",
        "ActorTalk": "You've always been going around as a Commissioner. But today, during this celebration, I hope you can put that aside, at least for a little while, and take time for yourself.",
        "Cv": 510002294.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "Lucia",
        "ActorTalk": "Let's just be two ordinary visitors today, and enjoy the celebration like everyone else. Is that alright, Commandant?",
        "Cv": 510002295.0,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": null,
        "ActorTalk": "Lucia.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": null,
        "ActorTalk": "What were you just looking at?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": null,
        "ActorTalk": "Expressions?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": null,
        "ActorTalk": "You're smiling the same way.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": null,
        "ActorTalk": "I wouldn't say that.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "It hasn't been easy.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "Sure thing.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 19,
        "ActorName": null,
        "ActorTalk": "Let's go.",
        "Cv": null,
        "Desc": null
    }
]