    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "Turn yourself in?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "Verus",
        "ActorTalk": "Ah, you're the Gray Raven Commandant!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "Verus",
        "ActorTalk": "Please help me! I think I've... no, I definitely got myself into trouble.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "What did you do?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": "Verus",
        "ActorTalk": "I... made some \"tiny\" unauthorized modifications to the Kuroro in the garden area...",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": "Verus",
        "ActorTalk": "Because of my unauthorized modifications to Kuroro, Tris has become suspicious of me, and she's even been punished because of it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": "Verus",
        "ActorTalk": "If I keep hiding the truth, who knows what other problems might arise.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "If it was me, I would face up to it.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "Verus",
        "ActorTalk": "Is that so?",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "I won't run away from my responsibilities.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 12,
        "ActorName": "Verus",
        "ActorTalk": "Alright, I know what I need to do now. Thank you.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 13,
        "ActorName": "Verus",
        "ActorTalk": "Ah, I did actually enroll in that pilot training course for active personnel offered by the Science Council.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 14,
        "ActorName": "Verus",
        "ActorTalk": "In that \"Intelligent Machine Theory and Wartime Multi-Dimensional Practical Exercises (Beginner)\" course, I was the only student who passed!",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 15,
        "ActorName": "Verus",
        "ActorTalk": "I'm not lying.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 16,
        "ActorName": "Verus",
        "ActorTalk": "My skill level only allows me to make minor tweaks that wouldn't do any real harm.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 17,
        "ActorName": null,
        "ActorTalk": "You should report yourself to the Science Council, kiddo.",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 18,
        "ActorName": null,
        "ActorTalk": "Your guilty-sounding tone is pretty suspicious.",
        "Cv": null,
        "Desc": null
    }
