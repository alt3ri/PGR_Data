        "RuleTitleList": "['\u6d3b\u52a8\u8bf4\u660e', '\u786e\u8ba4\u7814\u53d1', '\u5956\u52b1\u8bf4\u660e', '\u7814\u53d1\u6d88\u8017', '\u8d27\u5e01\u8bf4\u660e', '\u6d6e\u52a8\u6982\u7387', '\u989d\u5916\u5956\u52b1']",
        "RuleTextList": "['\u6d82\u88c5\u7814\u53d1\u6d3b\u52a8\u5305\u542b\u3010\u7f6a\u5984\u6708\u534e\u3011\u3001\u3010\u7eee\u5f71\u51db\u7136\u3011\u3001\u3010\u70b8\u88c2\u9713\u8679\u3011\u3001\u3010\u7eee\u613f\u7a1a\u68a6\u3011\uff0c\u6307\u6325\u5b98\u53ef\u4ee5\u9009\u62e9\u5176\u4e2d1\u6b3e\u6d82\u88c5\u8fdb\u884c\u7814\u53d1', '\u6d3b\u52a8\u5185\uff0c\u6307\u6325\u5b98\u53ea\u67091\u6b21\u9009\u62e9\u6d82\u88c5\u7814\u53d1\u7684\u673a\u4f1a\uff0c\u786e\u8ba4\u9009\u62e9\u540e\uff0c\u4e0d\u53ef\u66f4\u6539', '\u6240\u6709\u5956\u52b1\u5747\u4e3a\u9650\u91cf\u7269\u54c1\uff0c\u62bd\u53d6\u540e\u65e0\u6cd5\u518d\u6b21\u83b7\u5f97\uff1b\\\\n\u5b8c\u6210\u301010\u6b21\u3011\u7814\u53d1\u5fc5\u5b9a\u83b7\u53d6\u9009\u53d6\u7684\u6210\u5458\u6d82\u88c5', '\u6bcf\u6b21\u7814\u53d1\u5747\u9700\u8981\u6d88\u8017\u3010\u7814\u53d1\u9053\u5177\u3011\uff0c\u4e14\u7814\u53d1\u6d88\u8017\u9012\u589e\uff1b\\\\n\u6bcf\u6b21\u7814\u53d1\u6d88\u8017\uff1a50/100/250/400/600/800/1200/1700/2200/2700', '\u7814\u53d1\u6240\u9700\u7684\u3010\u7814\u53d1\u9053\u5177\u3011\u6570\u76ee\u4e0d\u8db3\u65f6\uff0c\u53ef\u6d88\u8017\u9ed1\u5361\u6216\u8679\u5361\u5151\u6362\\\\n\u9ed1\u5361\uff1a\u7b49\u989d\u5151\u6362    \u8679\u5361\uff1a\u6298\u6263\u5151\u6362\\\\n\u3010\u7814\u53d1\u9053\u5177\u3011\u5c06\u4e8e\u7814\u53d1\u6d3b\u52a8\u7ed3\u675f\u540e1:1\u6298\u6362\u6210\u9ed1\u5361', '\u6bcf\u6b21\u7814\u53d1\u83b7\u53d6\u5404\u79cd\u5956\u52b1\u7684\u6982\u7387\u4e0d\u540c\uff0c\u3010\u7b2c5\u6b21\u3011\u5f00\u59cb\u5373\u6709\u6982\u7387\u83b7\u5f97\u3010\u9009\u53d6\u7684\u6d82\u88c5\u3011\uff1b\\\\n\u53ef\u524d\u5f80\u3010\u6389\u843d\u8be6\u60c5\u3011\u67e5\u770b\u6bcf\u6b21\u7814\u53d1\u83b7\u5f97\u5404\u79cd\u5956\u52b1\u7684\u6982\u7387', '\u7814\u53d1\u6b21\u6570\u8fbe\u5230\u30108\u6b21\u3011\uff0c\u53ef\u83b7\u5f97\u989d\u5916\u5956\u52b1\u3010\u6d82\u88c5\u5934\u50cf\u3011']"
