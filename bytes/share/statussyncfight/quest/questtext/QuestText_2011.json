    },
    {
        "Id": 15,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 16,
        "Text": "\u4e0e\u5361\u5217\u5c3c\u5a1c\u5bf9\u8bdd"
    },
    {
        "Id": 17,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 18,
        "Text": "\u8ddf\u968f\u5927\u9ed1\u524d\u5f80\u5f02\u5e38\u4fe1\u53f7\u5904"
    },
    {
        "Id": 19,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 20,
        "Text": "\u901a\u8fc7\u76f8\u673a\u627e\u51fa\u4f2a\u88c5\u5e93\u6d1b\u6d1b"
    },
    {
        "Id": 21,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 22,
        "Text": null
    },
    {
        "Id": 23,
        "Text": "\u7a7a\u4e2d\u82b1\u56ed-\u5546\u4e1aB\u533a"
    },
    {
        "Id": 24,
        "Text": "\u5bfb\u627e\u68a6\u6656\u7eff\u836b\u7684\u4f2a\u88c5\u5e93\u6d1b\u6d1b\uff08\u5176\u4e00\uff09"
    },
    {
        "Id": 25,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 26,
        "Text": "\u5bfb\u627e\u68a6\u6656\u7eff\u836b\u7684\u4f2a\u88c5\u5e93\u6d1b\u6d1b\uff08\u5176\u4e8c\uff09"
    },
    {
        "Id": 27,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 28,
        "Text": "\u5bfb\u627e\u68a6\u6656\u7eff\u836b\u7684\u4f2a\u88c5\u5e93\u6d1b\u6d1b\uff08\u5176\u4e09\uff09"
    },
    {
        "Id": 29,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 30,
        "Text": "\u5411\u5927\u9ed1\u8be2\u95ee\u5f02\u5e38\u4fe1\u53f7\u7684\u5177\u4f53\u4f4d\u7f6e\uff08\u53ef\u9009\uff09"
    },
    {
        "Id": 31,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    },
    {
        "Id": 32,
        "Text": null
    },
    {
        "Id": 33,
        "Text": "\u7a7a\u4e2d\u82b1\u56ed-\u5546\u4e1aB\u533a"
    },
    {
        "Id": 34,
        "Text": "\u9605\u8bfb\u5e93\u6d1b\u6d1b\u6392\u67e5\u5c0f\u7ec4\u7684\u77ed\u4fe1"
    },
    {
        "Id": 35,
        "Text": "\u6765\u5230\u68a6\u6656\u7eff\u836b\u7684\u7070\u9e26\u6307\u6325\u5b98\u6536\u5230\u795e\u79d8\u4eba\u58eb\u53d1\u6765\u7684\u6d88\u606f\uff0c\u53d1\u73b0\u7adf\u662f\u5077\u62cd\u81ea\u5df1\u7684\u7167\u7247\uff0c\u8ddf\u968f\u7ebf\u7d22\u8ffd\u8e2a\u65f6\u5374\u88ab\u5bf9\u65b9\u9003\u6389\u3002\u4e0e\u6b64\u540c\u65f6\uff0c\u7070\u9e26\u6307\u6325\u5b98\u9047\u5230\u4e86\u540c\u6837\u5bfb\u627e\u795e\u79d8\u4eba\u58eb\u7684\u5361\u5217\u5c3c\u5a1c\u4e0e\u5de5\u7a0b\u90e8\u961f\u6280\u672f\u5458\u5927\u9ed1\u2026\u2026"
    }
