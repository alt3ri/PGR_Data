    },
    {
        "Id": 6,
        "Text": "\u4e0e\u7f57\u585e\u5854\u4f1a\u5408"
    },
    {
        "Id": 7,
        "Text": "\u6307\u6325\u5b98\u7a7f\u4e0a\u52a8\u529b\u7532\uff0c\u6765\u5230\u6237\u5916\u5e73\u53f0\uff0c\u770b\u5230\u7f57\u585e\u5854\u548c\u5047\u871c\u7eb3\u6b63\u5728\u6218\u6597"
    },
    {
        "Id": 8,
        "Text": "\u4e0e\u7f57\u585e\u5854\u4f1a\u5408"
    },
    {
        "Id": 9,
        "Text": null
    },
    {
        "Id": 10,
        "Text": null
    },
    {
        "Id": 11,
        "Text": "\u6307\u6325\u5b98\u8ffd\u4e86\u4e0a\u524d\uff0c\u770b\u89c1\u6b63\u5728\u6218\u6597\u7684\u7f57\u585e\u5854\u548c\u871c\u7eb3\uff0c\u5047\u871c\u7eb3\u89c1\u6307\u6325\u5b98\u7684\u5230\u6765\uff0c\u5411\u6307\u6325\u5b98\u8868\u660e\u4e86\u81ea\u5df1\u7684\u8eab\u4efd\uff0c\u65e7\u82cf\u83f2\u4e9a\u57ce\u6700\u540e\u7684\u7687\u5e1d\uff0c\u51b0\u5fc3\u7687\u624e\u514b\uff0c\u4ed6\u5728\u7a7a\u4e2d\u82b1\u56ed\u7684\u89c2\u5bdf\u5230\u5982\u4eca\u4e16\u754c\u4ecd\u672a\u6210\u4e3a\u4e00\u4f53\uff0c\u8fd9\u6b21\uff0c\u4ed6\u5c06\u4f1a\u5e26\u9886\u8fc7\u53bb\u4ea1\u7075\u7edf\u4e00\u8fd9\u4e2a\u4e16\u754c\u3002"
    },
    {
        "Id": 12,
        "Text": "\u4e0e\u7f57\u585e\u5854\u4ea4\u6d41\u73b0\u72b6"
    },
    {
        "Id": 13,
        "Text": "\u6307\u6325\u5b98\u548c\u7f57\u585e\u5854\u770b\u5230\u5760\u843d\u7684\u5047\u871c\u7eb3\u6d88\u5931\u8fd9\u4e4b\u540e\uff0c\u5728\u5e73\u53f0\u4e0a\u5bf9\u73b0\u72b6\u8fdb\u884c\u4e86\u4ea4\u6d41"
    },
    {
        "Id": 14,
        "Text": null
    },
    {
        "Id": 15,
        "Text": "\u6307\u6325\u5b98\u8131\u4e0b\u4e86\u52a8\u529b\u7532\uff0c\u4e58\u5750\u7535\u68af\u56de\u5230\u4e86\u519b\u5907\u533a\u3002"
    },
    {
        "Id": 16,
        "Text": "\u8fd4\u56de\u519b\u4e8b\u8b66\u5907\u533a"
    },
    {
        "Id": 17,
        "Text": null
    }
]