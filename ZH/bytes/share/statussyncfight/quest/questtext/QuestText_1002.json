[
    {
        "Id": 1,
        "Text": "\u51b0\u5fc3\u6f5c\u5f71"
    },
    {
        "Id": 2,
        "Text": "\u5f00\u7bc7\u4e86\u89e3\u7f57\u585e\u5854\u65b0\u673a\u4f53\u7684\u73b0\u72b6\uff0c\u4ee5\u53ca\u6307\u6325\u5b98\u9700\u8981\u505a\u7684\u4e8b\u60c5\uff0c\u5e2e\u52a9\u542f\u52a8\u7f57\u585e\u5854\u7684\u65b0\u673a\u4f53\uff0c\u4ee5\u53ca\u871c\u7eb3\u51fa\u573a\u7559\u4e0b\u60ac\u5ff5\u3002\\n"
    },
    {
        "Id": 3,
        "Text": null
    },
    {
        "Id": 4,
        "Text": null
    },
    {
        "Id": 5,
        "Text": "\u519b\u4e8b\u8b66\u5907\u533a"
    },
    {
        "Id": 6,
        "Text": null
    },
    {
        "Id": 7,
        "Text": null
    },
    {
        "Id": 8,
        "Text": "\u5728\u519b\u4e8b\u8b66\u5907\u533a\u8c03\u67e5"
    },
    {
        "Id": 9,
        "Text": "\u7f57\u585e\u5854\u56e0\u4e3a\u5bf9\u6297\u51fa\u73b0\u5728\u6781\u5730\u4e0a\u7684\u654c\u4eba\u800c\u9677\u5165\u4e86\u660f\u8ff7\uff0c\u5728\u7a7a\u4e2d\u82b1\u56ed\u4e2d\u5e94\u8be5\u80fd\u627e\u5230\u5e2e\u52a9\u7f57\u585e\u5854\u7684\u65b9\u6cd5\u3002"
    },
    {
        "Id": 10,
        "Text": null
    },
    {
        "Id": 11,
        "Text": "\u65e7\u82cf\u83f2\u4e9a\u57ce\u90ca\u5916"
    },
    {
        "Id": 12,
        "Text": "\u4f7f\u7528\u201c\u7360\u7259\u201d\u6e05\u9664\u610f\u8bc6\u6d77\u7d0a\u4e71"
    },
    {
        "Id": 13,
        "Text": "\u8981\u8ba9\u7f57\u585e\u5854\u9192\u8fc7\u6765\u5c31\u5fc5\u987b\u6df1\u6f5c\u5230\u610f\u8bc6\u6d77\u4e2d\u6253\u5f00\u201c\u9a6c\u5c14\u5e93\u7279\u201d\u673a\u4f53\u4e2d\u7684\u9ed1\u76d2\uff0c\u6253\u8d25\u773c\u524d\u7684\u654c\u4eba\uff0c\u8ba9\u9ed1\u76d2\u66b4\u9732\u51fa\u6765\u5427\u3002"
    },
    {
        "Id": 14,
        "Text": null
    },
    {
        "Id": 15,
        "Text": "\u519b\u4e8b\u8b66\u5907\u533a"
    },
    {
        "Id": 16,
        "Text": "\u8ffd\u4e0a\u7f57\u585e\u5854\u4e0e\u201c\u871c\u7eb3\u201d"
    },
    {
        "Id": 17,
        "Text": "\u6765\u5230\u7a7a\u4e2d\u82b1\u56ed\u7684\u201c\u871c\u7eb3\u201d\u5e76\u4e0d\u662f\u771f\u6b63\u7684\u201c\u871c\u7eb3\u201d\uff0c\u5728\u88ad\u51fb\u672a\u9042\u540e\uff0c\u4ed6\u4fbf\u8d81\u7740\u6df7\u4e71\u79bb\u5f00\u73b0\u573a\uff0c\u800c\u521a\u9192\u6765\u7f57\u585e\u5854\u4e5f\u8ffd\u4e86\u8fc7\u53bb\u3002"
    },
    {
        "Id": 18,
        "Text": null
    },
    {
        "Id": 19,
        "Text": "\u519b\u4e8b\u8b66\u5907\u533a \u5929\u53f0"
    },
    {
        "Id": 20,
        "Text": "\u4e0e\u7f57\u585e\u5854\u4f1a\u5408"
    },
    {
        "Id": 21,
        "Text": "\u5728\u4e00\u756a\u8ffd\u9010\u4ee5\u540e\uff0c\u4f17\u4eba\u90fd\u6765\u5230\u4e86\u519b\u4e8b\u8b66\u5907\u533a\u7684\u5929\u53f0\u3002"
    },
    {
        "Id": 22,
        "Text": null
    },
    {
        "Id": 23,
        "Text": "\u519b\u4e8b\u8b66\u5907\u533a"
    },
    {
        "Id": 24,
        "Text": "\u53bb\u89c1\u963f\u897f\u83ab\u592b"
    },
    {
        "Id": 25,
        "Text": "\u201c\u51b0\u5fc3\u7687\u201d\u7684\u5ba3\u8a00\u4ee3\u8868\u4e86\u4e00\u573a\u65b0\u7684\u5371\u673a\u4e0e\u6df7\u4e71\u5373\u5c06\u5f00\u59cb\uff0c\u6309\u7167\u963f\u897f\u83ab\u592b\u7684\u6307\u793a\uff0c\u5148\u53bb\u627e\u4ed6\u5546\u91cf\u4e0b\u4e00\u6b65\u8be5\u600e\u4e48\u505a\u5427\u3002"
    }
]