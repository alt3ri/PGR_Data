[
    {
        "Id": 1,
        "Text": "\u672a\u88ab\u7834\u89e3\u7684\u7f16\u7801"
    },
    {
        "Id": 2,
        "Text": "\u7a7a\u4e2d\u82b1\u56ed\u6559\u5b66\u697c\u5185\uff0c\u5e93\u6d1b\u6d1b\u51fa\u73b0\u4e86\u5f02\u5e38\u805a\u96c6\u73b0\u8c61\u3002\u963f\u897f\u83ab\u592b\u8ba9\u6307\u6325\u5b98\u4f7f\u7528\u4e00\u5957\u5c1a\u5728\u6d4b\u8bd5\u7684\u7cfb\u7edf\u300c\u89c6\u754c\u63a2\u67e5\u300d\u8c03\u67e5\u5f02\u5e38\u80cc\u540e\u7684\u771f\u76f8\u3002 \u968f\u7740\u8c03\u67e5\u6df1\u5165\uff0c\u4e00\u6bb5\u85cf\u5728\u5e93\u6d1b\u6d1b\u7f16\u7801\u4e2d\u7684\u9690\u79d8\u4fe1\u606f\u9010\u6e10\u6d6e\u51fa\u6c34\u9762\uff0c\u800c\u5b83\u6240\u6307\u5411\u7684\uff0c\u662f\u4e00\u4e2a\u5173\u4e8e\u7236\u4eb2\u3001\u5173\u4e8e\u9009\u62e9\u3001\u5173\u4e8e\u4e00\u751f\u7684\u6545\u4e8b\u3002"
