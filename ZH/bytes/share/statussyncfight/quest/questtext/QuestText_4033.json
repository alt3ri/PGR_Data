    {
        "Id": 17,
        "Text": null
    },
    {
        "Id": 18,
        "Text": "\u51fb\u8d25\u611f\u67d3\u4f53"
    },
    {
        "Id": 19,
        "Text": null
    },
    {
        "Id": 20,
        "Text": null
    },
    {
        "Id": 21,
        "Text": null
    },
    {
        "Id": 22,
        "Text": "\u89e3\u9501\u6570\u636e\u9ed1\u76d2"
    },
    {
        "Id": 23,
        "Text": "\u51fb\u5012\u6240\u6709\u602a\u7269\u540e\uff0c\u51fa\u73b0\u4e86\u4e00\u4e2a\u89e3\u9664\u673a\u4f53\u9ed1\u76d2\u7684\u542f\u52a8\u9501\uff0c\u6307\u6325\u5b98\u9700\u8981\u548c\u542f\u52a8\u9501\u4ea4\u4e92\u542f\u52a8\u7f57\u585e\u5854\u673a\u4f53"
    },
    {
        "Id": 24,
        "Text": null
    },
    {
        "Id": 25,
        "Text": "\u7f57\u585e\u5854\u673a\u4f53\u5f00\u59cb\u6162\u6162\u8fd0\u4f5c\uff0c\u8fd9\u91cc\u63d2\u6bb5\u64ad\u7247\u8f6c\u573a\u52a8\u753b\u3002"
    },
    {
        "Id": 26,
        "Text": null
    },
    {
        "Id": 27,
        "Text": "\u7f57\u585e\u5854\u673a\u4f53\u6210\u529f\u89e3\u9501\uff0c\u548c\u6307\u6325\u5b98\u4ee5\u901a\u8baf\u7684\u5f62\u5f0f\uff08\u5168\u8eab\u6a21\u578b\u5e26\u4e00\u4e9b\u901a\u8baf\u7279\u6548\uff09\u8bf4\u4e86\u4e00\u4e9b\u5173\u4e8e\u65e7\u82cf\u83f2\u4e9a\u57ce\u7684\u6545\u4e8b\uff0c\u4ece\u5bf9\u8bdd\u4e2d\uff0c\u6307\u6325\u5b98\u611f\u89c9\u5230\u7a7a\u4e2d\u82b1\u56ed\u4e2d\u7684\u871c\u7eb3\u4e0e\u7f57\u585e\u5854\u8ba4\u8bc6\u871c\u7eb3\u5e76\u975e\u540c\u4e00\u4e2a\u4eba\u3002\u968f\u540e\u6307\u6325\u5b98\u5c1d\u8bd5\u8054\u7cfb\u519b\u5907\u533a\u7684NPC\uff0c\u53d1\u73b0\u65e0\u6cd5\u901a\u8baf\uff0c\u6307\u6325\u5b98\u610f\u8bc6\u5230\u6709\u5371\u673a\u53d1\u751f\u4e86\u3002"
    }
]