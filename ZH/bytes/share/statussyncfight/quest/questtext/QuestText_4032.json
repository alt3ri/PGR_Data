    {
        "Id": 14,
        "Text": "\u5411\u6781\u5730\u673a\u68b0\u4e86\u89e3\u60c5\u51b5\uff08\u53ef\u9009\uff09"
    },
    {
        "Id": 15,
        "Text": "\u6307\u6325\u5b98\u4e00\u8def\u5411\u524d\u8c03\u67e5\uff0c\u884c\u8fdb\u9014\u4e2d\u548c\u519b\u5907\u533a\u8fc7\u9053\u4e0a\u7684\u6781\u5730\u673a\u5668\u7b80\u5355\u4ea4\u6d41\u4e86\u51e0\u53e5"
    },
    {
        "Id": 16,
        "Text": "\u5411\u5de5\u7a0b\u5e08\u4e86\u89e3\u60c5\u51b5\uff08\u53ef\u9009\uff09"
