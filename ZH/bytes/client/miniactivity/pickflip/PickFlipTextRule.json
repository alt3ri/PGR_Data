        "Id": 1,
        "ActivityId": 1,
        "Title": "\u89c4\u5219\u8bf4\u660e",
        "RuleTitles": "['\u81ea\u9009\u5956\u52b1', '\u5956\u6c60\u751f\u6210', '\u989d\u5916\u5956\u52b1', '\u751f\u547d\u4e4b\u6811']",
        "RuleDescs": "['\u70b9\u51fb\u3010\u914d\u7f6e\u5956\u52b1\u3011\u6309\u94ae\uff0c\u53ef\u81ea\u9009\u914d\u7f6e\u90e8\u5206\u547d\u8fd0\u5fae\u5149\u5956\u52b1\uff0c\u52a0\u5165\u8fd9\u4e00\u5c42\u7684\u5956\u52b1\u6c60\u4e2d\u3002', '\u81ea\u9009\u5956\u52b1\u914d\u7f6e\u5b8c\u6210\u540e\uff0c\u5c06\u5728\u8fd9\u4e00\u5c42\u7684\u56fa\u5b9a\u5956\u52b1\u4e2d\u968f\u673a\u62bd\u53d6\u5956\u52b1\uff0c\u586b\u5145\u5956\u6c60\u7684\u5269\u4f59\u4f4d\u7f6e\u3002\u56fa\u5b9a\u5956\u52b1\u7684\u968f\u673a\u6982\u7387\uff0c\u53ef\u4ee5\u5728\u3010\u89c4\u5219-\u6389\u843d\u8be6\u60c5\u3011\u4e2d\u8fdb\u884c\u67e5\u770b\u3002', '\u6d88\u8017\u3010\u7ec7\u5149\u4e4b\u4e1d\u3011\u7ffb\u5f00\u5361\u724c\uff0c\u5373\u53ef\u83b7\u5f97\u5956\u52b1\uff1b\u6bcf\u4e00\u5c42\u7684\u5361\u724c\u5168\u90e8\u7ffb\u5f00\u540e\uff0c\u53ef\u4ee5\u989d\u5916\u83b7\u5f97\u8fd9\u4e00\u5c42\u7684\u91cc\u7a0b\u5956\u52b1\u3002', '\u3010\u6e90\u8d28\u7ed3\u6676\u3011\u53ef\u5728\u6d3b\u52a8\u5546\u5e97\u3010\u751f\u547d\u4e4b\u6811\u3011\u4e2d\u5151\u6362\u6d82\u88c5\u7b49\u5546\u54c1\u3002']"
    }
