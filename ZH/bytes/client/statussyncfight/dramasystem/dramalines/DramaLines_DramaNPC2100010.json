        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "\u827a\u672f\u7231\u597d\u8005",
        "ActorTalk": "\u7070\u9e26\u6307\u6325\u5b98\uff0c\u60a8\u6765\u8bc4\u8bc4\u7406\uff0c\u8fc7\u4e00\u9635\u5b50\u4e0d\u662f\u4f1a\u6709\u76f8\u5173\u4e3b\u9898\u5c55\u89c8\u5417\uff1f\u60a8\u8bf4\uff0c\u662f\u4e0d\u662f\u4f1a\u9020\u6210\u4e0d\u597d\u7684\u5bfc\u5411\uff1f",
