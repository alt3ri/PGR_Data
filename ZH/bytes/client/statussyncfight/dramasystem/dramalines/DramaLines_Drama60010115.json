[
    {
        "TextId": 1,
        "ActorName": "\u4e09\u5e74\u7ea7",
        "ActorTalk": "\u5f53\u5e74\u7684\u6bd5\u4e1a\u8003\u6838\u53ef\u662f\u5730\u9762\u5b9e\u6218\u6f14\u7ec3\uff0c\u7ed3\u679c\u51fa\u4e86\u610f\u5916\uff0c\u636e\u8bf4\u6b7b\u4f24\u4e0d\u5c11\uff0c\u662f\u6cd5\u5965\u65af\u5efa\u6821\u53f2\u6765\u6700\u60e8\u91cd\u7684\u5b9e\u6218\u6f14\u7ec3\u4e4b\u4e00\u3002\u4ece\u90a3\u4e4b\u540e\uff0c\u5b9e\u6218\u6f14\u7ec3\u5c31\u53d6\u6d88\u4e86\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": "\u4e8c\u5e74\u7ea7",
        "ActorTalk": "\u662f\u7070\u9e26\u6307\u6325\u5b98\u548c\u51e1\u59ae\u838e\u5b66\u59d0\u4ed6\u4eec\u90a3\u4e00\u5c4a\u5417\uff1f",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "\u4e09\u5e74\u7ea7",
        "ActorTalk": "\u6ca1\u9519\u3002\u7070\u9e26\u6307\u6325\u5b98\u4e00\u5f00\u59cb\u88ab\u5217\u4e3a\u5931\u8e2a\uff0c\u6700\u540e\u5947\u8ff9\u822c\u751f\u8fd8\u4e86\u3002\u4e0d\u8fc7\uff0c\u636e\u6211\u5728\u751f\u547d\u4e4b\u661f\u7684\u4eba\u8109\u8bf4\uff0c\u7070\u9e26\u6307\u6325\u5b98\u51fa\u73b0\u4e86\u8111\u5916\u4f24\u540e\u9057\u75c7\uff0c\u6709\u90e8\u5206\u5931\u5fc6\u7684\u60c5\u51b5\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": "\u4e8c\u5e74\u7ea7",
        "ActorTalk": "\u80fd\u6d3b\u4e0b\u6765\u5c31\u96be\u4ee5\u60f3\u8c61\u4e86\u3002\u4e4b\u524d\u6211\u770b\u8fc7\u90e8\u5206\u6a21\u62df\u8003\u9898\u7684\u9898\u5e93\uff0c\u542c\u8bf4\u90fd\u662f\u771f\u5b9e\u53d1\u751f\u8fc7\u7684\u6218\u51b5\uff0c\u8981\u662f\u6211\u5728\u90a3\u4e2a\u6761\u4ef6\u4e0b\uff0c\u6839\u672c\u5c31\u6d3b\u4e0d\u4e0b\u6765\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": "\u4e09\u5e74\u7ea7",
        "ActorTalk": "\u9664\u4e86\u7070\u9e26\u6307\u6325\u5b98\uff0c\u8fd8\u6709\u54ea\u4e9b\u5b66\u59d0\u5b66\u957f\u662f\u90a3\u4e00\u5c4a\u7684\u5b66\u751f\uff1f",
