        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\u4f60\u521a\u624d\u662f\u5728\u770b\u5e7f\u573a\u4e2d\u592e\u7684\u6295\u5f71\u5417\uff1f\u90a3\u91cc\u7684\u5149\u5f71\u53d8\u6362\u522b\u5177\u4e00\u683c\uff0c\u6211\u6bcf\u6b21\u8def\u8fc7\u90fd\u4f1a\u5fcd\u4e0d\u4f4f\u591a\u770b\u4e24\u773c\u3002",
