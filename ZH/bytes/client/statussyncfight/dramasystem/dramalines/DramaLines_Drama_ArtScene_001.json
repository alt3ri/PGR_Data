[
    {
        "TextId": 1,
        "ActorName": null,
        "ActorTalk": "\u300a\u53cd\u51fb\u65f6\u4ee3\u5728\u53ec\u5524\u300b",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u5916\u5f62\uff1a\u4ee5\u4f4e\u591a\u8fb9\u5f62\u62d3\u6251\u7ed3\u6784\u6784\u5efa\uff0c\u6574\u4f53\u5448\u73b0 \u201c\u534a\u8680\u6bcd\u661f\u201d \u7684\u9690\u55bb\u5f62\u6001\u2014\u2014\u4e00\u4fa7\u662f\u88ab\u5e15\u5f25\u4ec0\u4fb5\u8680\u7684\u7834\u788e\u7070\u8c03\u7ed3\u6784\uff0c\u5982\u672b\u4e16\u5e9f\u589f\u822c\u72f0\u72de\uff1b\u53e6\u4e00\u4fa7\u5219\u662f\u5145\u6ee1\u529b\u91cf\u611f\u7684\u5973\u6027\u8f6e\u5ed3\uff0c\u6b8b\u5b58\u7684\u80a2\u4f53\u4ecd\u4fdd\u6301\u7740\u5411\u524d\u4f38\u5c55\u7684\u59ff\u6001\uff0c\u6307\u5c16\u76f4\u6307\u201c\u672a\u6765\u4e0e\u5e0c\u671b\u201d\u7684\u65b9\u5411\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "\u7ebf\u6761\u9510\u5229\u5982\u6218\u5203\u6b8b\u7247\uff0c\u7070\u8c03\u91d1\u5c5e\u8d28\u611f\u7684\u8868\u9762\u5728\u5149\u5f71\u4e0b\u6298\u5c04\u51fa\u7834\u788e\u5374\u5bcc\u6709\u97f5\u5f8b\u7684\u68f1\u5149\uff0c\u9759\u6001\u4e2d\u6ee1\u662f \u201c\u8eab\u9677\u6ce5\u6cde\u5374\u5411\u5149\u51b2\u950b\u201d \u7684\u52a8\u6001\u5f20\u529b\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "\u7c7b\u578b\uff1a\u6570\u5b57\u827a\u672f\u4e0e\u5b9e\u4f53\u96d5\u5851\u878d\u5408\u7684 \u201c\u53cd\u51fb\u4e3b\u9898\u62d3\u6251\u96d5\u5851\u201d\uff0c\u7531\u827a\u672f\u534f\u4f1a\u8054\u5408\u5386\u53f2\u7814\u7a76\u56e2\u961f\u5171\u521b\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "\u610f\u4e49\uff1a\u5b83\u662f\u5965\u6797\u5339\u4e9a\u827a\u672f\u9986 \u201c\u53cd\u51fb\u65f6\u4ee3\u7cbe\u795e\u56fe\u817e\u201d \u7684\u5177\u8c61\u8868\u8fbe\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "\u521b\u4f5c\u8005\u4ee5 \u201c\u5730\u7403\u6bcd\u661f\u5728\u5e15\u5f25\u4ec0\u4fb5\u8680\u4e0b\u7684\u4e0d\u5c48\u610f\u5fd7\u201d \u4e3a\u547d\u9898\uff0c\u7528\u51e0\u4f55\u7834\u788e\u611f\u5448\u73b0\u53cd\u51fb\u65f6\u4ee3\u7684\u727a\u7272\u4e0e\u8363\u5149\u2014\u2014\u88ab\u4fb5\u8680\u7684\u534a\u8eab\u4e3a\u5730\u7403\u7684\u82e6\u96be\u70d9\u5370\uff0c\u4f38\u5c55\u7684\u80a2\u4f53\u5219\u662f\u6218\u58eb\u4eec \u201c\u56de\u5e94\u53ec\u5524\u3001\u5411\u5e0c\u671b\u51b2\u950b\u201d \u7684\u4fe1\u5ff5\u5177\u8c61\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "\u5176\u8868\u9762\u591a\u53d8\u7684\u989c\u8272\u8c61\u5f81\u5730\u7403\u7684\u4f24\u75d5\u4e0e\u4eba\u7c7b\u7684\u53cd\u51fb\u610f\u5fd7\u5171\u751f\uff0c\u662f\u94a2\u94c1\u7a79\u9876\u4e0b\u6c38\u4e0d\u7184\u706d\uff0c\u8a93\u8981 \u201c\u593a\u56de\u6bcd\u661f\u201d \u7684\u7cbe\u795e\u706b\u79cd\u3002",
        "Cv": null,
        "Desc": null
    }
]