    },
    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u5348\u540e\u6d12\u843d\u7684\u91d1\u8272\u5149\u8f89\uff0c\u6084\u7136\u878d\u5165\uff0c\u4ee4\u6574\u4f53\u98ce\u5473\u66f4\u663e\u548c\u8c10\u67d4\u548c\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 3,
        "ActorName": null,
        "ActorTalk": "\u6e29\u6da6\u800c\u60a0\u957f\uff0c\u5e26\u7740\u4f3c\u66fe\u76f8\u8bc6\u7684\u4f59\u97f5\uff0c\u52fe\u8d77\u8bb0\u5fc6\u6df1\u5904\u7684\u6000\u5ff5\u4e0e\u6e29\u5ea6\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 4,
        "ActorName": null,
        "ActorTalk": "\u6e05\u65b0\u4e2d\u900f\u7740\u4e00\u4e1d\u5fae\u751c\uff0c\u5982\u540c\u590f\u65e5\u508d\u665a\u7684\u5fae\u98ce\u62c2\u8fc7\u6d77\u5cb8\uff0c\u6e29\u67d4\u4e14\u5e26\u7740\u4ee4\u4eba\u96be\u5fd8\u7684\u4f59\u97f5\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 5,
        "ActorName": null,
        "ActorTalk": "\u5e26\u7740\u5927\u5730\u7684\u6c14\u606f\uff0c\u4eff\u4f5b\u6625\u65e5\u679d\u5934\u7684\u82b1\u6735\uff0c\u7efd\u653e\u51fa\u6e29\u6696\u4e14\u771f\u631a\u7684\u60c5\u611f\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 6,
        "ActorName": null,
        "ActorTalk": "\u56de\u5473\u60a0\u957f\uff0c\u4eff\u4f5b\u65f6\u95f4\u5728\u8fd9\u4e00\u523b\u505c\u9a7b\uff0c\u8ba9\u76f8\u9047\u7684\u77ac\u95f4\u66f4\u52a0\u6df1\u523b\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 7,
        "ActorName": null,
        "ActorTalk": "\u7ec6\u817b\u800c\u60a0\u8fdc\uff0c\u4eff\u4f5b\u65f6\u95f4\u5728\u7f13\u7f13\u6d41\u8f6c\uff0c\u5c42\u5c42\u53e0\u53e0\u7684\u97f5\u5473\u4ea4\u9519\uff0c\u8574\u85cf\u7740\u4e0d\u66fe\u8a00\u8bf4\u7684\u6545\u4e8b\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 8,
        "ActorName": null,
        "ActorTalk": "\u5fae\u5149\u8dc3\u52a8\u4e8e\u676f\u4e2d\uff0c\u4f59\u97f5\u7f2d\u7ed5\uff0c\u5ba3\u793a\u6df1\u85cf\u5fc3\u5e95\u7684\u70bd\u70ed\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": null,
        "ActorTalk": "\u9187\u539a\u7684\u6c14\u606f\u5982\u51dd\u56fa\u5fae\u5149\uff0c\u6c89\u9189\u611f\u5b98\uff0c\u7b49\u5f85\u8fce\u63a5\u5d2d\u65b0\u7684\u76f8\u9022\u3002",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "\u5de5\u4f5c\u4eba\u5458",
        "ActorTalk": "\u4e3a\u4e86\u611f\u8c22\u65b0\u8001\u987e\u5ba2\u7684\u652f\u6301\uff0c\u661f\u5c18\u917f\u6ce1\u7279\u522b\u63a8\u51fa\u201c\u5171\u996e\u4eca\u5bb5\u201d\u6d3b\u52a8\u3002\u60a8\u53ef\u4ee5\u4f7f\u7528\u5e97\u5185\u63d0\u4f9b\u7684\u539f\u6599\uff0c\u81ea\u7531\u642d\u914d\uff0c\u4e3a\u81ea\u5df1\u3001\u4e3a\u4ed6\u4eba\uff0c\u6216\u662f\u5f7c\u6b64\u8c03\u5236\u4e00\u676f\u72ec\u7279\u7684\u996e\u54c1\u3002",
        "Cv": 510000235.0,
        "Desc": null
    },
    {
        "TextId": 11,
        "ActorName": "\u5de5\u4f5c\u4eba\u5458",
