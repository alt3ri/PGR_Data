    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\uff08\u7ec8\u7aef\u663e\u793a\u7684\u65e5\u671f\u505c\u7559\u5728\u6628\u65e5\uff0c\u4f11\u606f\u5ba4\u5185\u7684\u7269\u54c1\u4e5f\u6089\u6570\u6062\u590d\u81f3\u5f53\u65f6\u7684\u72b6\u6001\uff0c\u8fd8\u6709\u8fc7\u53bb\u4e8b\u60c5\u91cd\u73b0\u3002\u81ea\u5df1\u4eff\u4f5b\u5c31\u50cf\u2026\u2026\u9677\u5165\u4e86\u65f6\u95f4\u5faa\u73af\u4e00\u6837\u3002\uff09",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\uff08\u773c\u4e0b\u73b0\u72b6\u4e0e\u300a\u963f\u5446\u86d9\u4e4b\u65e5\u300b\u7684\u60c5\u8282\u4e0e\u5982\u51fa\u4e00\u8f99\uff0c\u800c\u68a6\u5883\u4e2d\u53cd\u590d\u51fa\u73b0\u7684\u753b\u9762\uff0c\u540c\u6837\u4e0e\u963f\u5446\u86d9\u606f\u606f\u76f8\u5173\u2026\u2026\u6216\u8bb8\u7b54\u6848\u5c31\u85cf\u5728\u5f71\u7247\u4e4b\u4e2d\uff1f\uff09",
        "Cv": null,
        "Desc": null
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "\uff08\u201c\u771f\u631a\u7684\u5fc3\u613f\u80fd\u5b55\u80b2\u51fa\u5947\u8ff9\u201d\u2014\u2014\u8fd9\u662f\u7535\u5f71\u7684\u6838\u5fc3\u4e3b\u9898\u3002\u5982\u679c\u8fd9\u4e2a\u5faa\u73af\u9075\u5faa\u540c\u6837\u7684\u89c4\u5219\uff0c\u6216\u8bb8\u79bb\u5f00\u7684\u5173\u952e\uff0c\u5728\u4e8e\u6ee1\u8db3\u8c01\u7684\u5fc3\u613f\uff0c\u800c\u81f3\u4e8e\u662f\u8c01\u2026\u2026\uff09",
        "Cv": null,
        "Desc": null
    },
    {
