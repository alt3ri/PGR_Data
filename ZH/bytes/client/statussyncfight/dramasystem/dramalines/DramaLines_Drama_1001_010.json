    {
        "TextId": 2,
        "ActorName": null,
        "ActorTalk": "\u6211\u6700\u8fd1\u5b66\u5230\u4e00\u79cd\u65b0\u7684\u6298\u6cd5\uff0c\u7528\u8fd9\u79cd\u65b9\u6cd5\u6298\u51fa\u7684\u56db\u53f6\u8349\u66f4\u52a0\u7acb\u4f53\u3002\u642d\u914d\u5149\u6cfd\u611f\u5f3a\u7684\u7eb8\u5f20\uff0c\u653e\u5728\u9633\u5149\u4e0b\u4f1a\u95ea\u95ea\u53d1\u5149\uff0c\u5f88\u6f02\u4eae\u3002",
