    },
    {
        "Id": 108,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8587\u62c9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u94f6\u8272"
    },
    {
        "Id": 109,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8587\u62c9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 110,
        "Text": "\u8352\u91ce\u98d9\u5ba2"
    },
    {
        "Id": 111,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u963f\u5c14\u6cd5"
    },
    {
        "Id": 112,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u963f\u5c14\u6cd5 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u94f6\u8272"
    },
    {
        "Id": 113,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u963f\u5c14\u6cd5 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 114,
        "Text": "\u9057\u4e16\u9690\u5fc3"
    },
    {
        "Id": 115,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u7ef4\u91cc\u8036"
    },
    {
        "Id": 116,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u7ef4\u91cc\u8036 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u94f6\u8272"
    },
    {
        "Id": 117,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u7ef4\u91cc\u8036 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 118,
        "Text": "\u5fe0\u8bda\u4f19\u4f34"
    },
    {
        "Id": 119,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u592a\u963f"
    },
    {
        "Id": 120,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u592a\u963f \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u94f6\u8272"
    },
    {
        "Id": 121,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u592a\u963f \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 122,
        "Text": "\u6df1\u7a7a\u542f\u660e\u661f"
    },
    {
        "Id": 123,
        "Text": "\u4ec5\u6709\u6781\u5c0f\u90e8\u5206\u4eba\u80fd\u5f97\u5230\u7684\u6b8a\u8363\uff0c\u4f60\u5c06\u5e26\u6765\u7834\u6653\uff0c\u63e1\u4f4f\u5149\u660e\u3002"
    },
    {
        "Id": 124,
        "Text": "\u91cd\u590d\u83b7\u5f97\u540e\u53ef\u5ef6\u957f\u6709\u6548\u65f6\u95f4\uff0c\u6709\u6548\u671f\u4e3a{0}\u5929"
    },
    {
        "Id": 125,
        "Text": "\u6781\u57df\u534f\u4f5c\u5404\u699c\u5355\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 126,
        "Text": "\u5bd2\u96ea\u6d88\u878d"
    },
    {
        "Id": 127,
        "Text": "\u4e3a\u4e86\u5609\u5956\u5728\u534f\u4f5c\u6a21\u62df\u6218\u4e2d\u83b7\u5f97\u4f18\u5f02\u6210\u7ee9\u7684\u6307\u6325\u5b98\uff0c\u7a7a\u4e2d\u82b1\u56ed\u7279\u5236\u7684\u94ed\u724c\u3002"
    },
    {
        "Id": 128,
        "Text": "\u91cd\u590d\u83b7\u5f97\u540e\u53ef\u63d0\u5347\u54c1\u8d28\uff0c\u6709\u6548\u671f\u4e3a{0}\u5929"
    },
    {
        "Id": 129,
        "Text": "\u6807\u51c6\u63a8\u6f14\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 130,
        "Text": "\u6781\u57df\u534f\u4f5c-\u6807\u51c6\u63a8\u6f14\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 131,
        "Text": "\u96fe\u6d77\u706f\u5854"
    },
    {
        "Id": 132,
        "Text": "\u6545\u969c\u8fde\u643a\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 133,
        "Text": "\u6781\u57df\u534f\u4f5c-\u6545\u969c\u8fde\u643a\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 134,
        "Text": "\u7e41\u661f\u65c5\u4eba"
    },
    {
        "Id": 135,
        "Text": "\u9669\u8c61\u73af\u751f\u7d2f\u8ba1\u5230\u8fbe\u6307\u5b9a\u79ef\u5206\uff0c\u6216\u699c\u5355\u524d{0}%\u53ef\u5f97"
    },
    {
        "Id": 136,
        "Text": "\u6781\u57df\u534f\u4f5c-\u9669\u8c61\u73af\u751f\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 137,
        "Text": "\u8fd9\u5c31\u662f\u9996\u5e2d"
    },
    {
        "Id": 138,
        "Text": "\u4ec5\u6709\u6781\u5c0f\u90e8\u5206\u4eba\u80fd\u5f97\u5230\u7684\u6b8a\u8363\uff0c\u4e0d\u65ad\u7a81\u7834\u81ea\u6211\u6781\u9650\u7684\u8bc1\u660e"
    },
    {
        "Id": 139,
        "Text": "\u83b7\u53d6\u540e{0}\u5929\u6709\u6548"
    },
    {
        "Id": 140,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301850000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 141,
        "Text": "\u767e\u80dc\u56f0\u517d"
    },
    {
        "Id": 142,
        "Text": "\u5e76\u975e\u7a7a\u4e2d\u82b1\u56ed\u5b98\u65b9\u53d1\u884c\uff0c\u800c\u5728\u6307\u6325\u5b98\u56e2\u4f53\u5185\u90e8\u81ea\u5236\u5e76\u6d41\u901a\uff0c\u53ea\u4f1a\u9881\u53d1\u7ed9\u5728\u6a21\u62df\u6218\u4e2d\u540d\u5217\u524d\u8305\u7684\u4eba"
    },
    {
        "Id": 143,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301800000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 144,
        "Text": "\u56da\u7b3c\u6597\u58eb"
    },
    {
        "Id": 145,
        "Text": "\u4e3a\u4e86\u5609\u5956\u5728\u6a21\u62df\u6218\u4e2d\u83b7\u5f97\u4f18\u5f02\u6210\u7ee9\u7684\u6307\u6325\u5b98\uff0c\u7a7a\u4e2d\u82b1\u56ed\u7279\u5236\u7684\u94ed\u724c"
    },
    {
        "Id": 146,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u7ec8\u7ea7\u533a\u8fbe\u52301750000\u8ba8\u4f10\u503c\u53ef\u83b7\u5f97"
    },
    {
        "Id": 147,
        "Text": "\u953b\u8000\u7edf\u5fa1"
    },
    {
        "Id": 148,
        "Text": "\u53ea\u6709\u5728\u6a21\u62df\u6218\u4e2d\u6210\u7ee9\u6700\u4e3a\u9876\u5c16\u7684\u6307\u6325\u5b98\u624d\u80fd\u83b7\u6b64\u6b8a\u8363\u3002"
    },
    {
        "Id": 149,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d{0}%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 150,
        "Text": "\u953b\u8000\u7cbe\u82f1"
    },
    {
        "Id": 151,
        "Text": "\u5956\u52b1\u7ed9\u4e3a\u6a21\u62df\u6218\u6570\u636e\u63d0\u4f9b\u4e86\u4f18\u79c0\u53c2\u8003\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 152,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d1%~5%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 153,
        "Text": "\u953b\u8000\u575a\u5175"
    },
    {
        "Id": 154,
        "Text": "\u6388\u4e88\u79ef\u6781\u53c2\u4e0e\u6a21\u62df\u6218\u6597\uff0c\u5e76\u5b8c\u6210\u51fa\u8272\u8868\u73b0\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 155,
        "Text": "\u5e7b\u75db\u56da\u7b3c\u93d6\u6218\u70b9\u524d5%~10%\u7684\u73a9\u5bb6\u53ef\u83b7\u5f97"
    },
    {
        "Id": 156,
        "Text": "\u5b8c\u7f8e\u6d4b\u7b97"
    },
    {
        "Id": 157,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u91cc \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 158,
        "Text": "\u767d\u663c\u4e00\u68a6"
    },
    {
        "Id": 159,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u4e07\u4e8b \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 160,
        "Text": "\u9053\u5316\u5e08"
    },
    {
        "Id": 161,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u7f57\u5170 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 162,
        "Text": "\u618e\u6076\u51f6\u72fc"
    },
    {
        "Id": 163,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u5361\u7a46 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 164,
        "Text": "\u94ed\u8bb0\u8005"
    },
    {
        "Id": 165,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u6e21\u8fb9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 166,
        "Text": "\u6267\u68cb\u4eba"
    },
    {
        "Id": 167,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u5e93\u6d1b\u59c6 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 168,
        "Text": "\u6e38\u9f99\u60ca\u9e3f"
    },
    {
        "Id": 169,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u5e38\u7fbd \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 170,
        "Text": "\u5408\u91d1\u91cd\u76fe"
    },
    {
        "Id": 171,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u795e\u5a01 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 172,
        "Text": "\u6708\u9762\u6f2b\u6b65"
    },
    {
        "Id": 173,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u5361\u5217\u5c3c\u5a1c \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 174,
        "Text": "\u591c\u8239\u97f6\u5149"
    },
    {
        "Id": 175,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u84b2\u7262 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 176,
        "Text": "\u6797\u5730\u6781\u5149"
    },
    {
        "Id": 177,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u7f57\u585e\u5854 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 178,
        "Text": "\u8346\u68d8\u94f6\u51a0"
    },
    {
        "Id": 179,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u9732\u5a1c \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 180,
        "Text": "\u63a2\u5bfb\u771f\u7406"
    },
    {
        "Id": 181,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u6bd4\u5b89\u5361 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 182,
        "Text": "\u6d6e\u68a6\u9e22\u5c3e"
    },
    {
        "Id": 183,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8d5b\u7433\u5a1c \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 184,
        "Text": "\u6c38\u4e16\u5e1d\u541b"
    },
    {
        "Id": 185,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u66f2 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 186,
        "Text": "\u70d9\u94f6\u8fc5\u7259"
    },
    {
        "Id": 187,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u82cf\u83f2\u4e9a \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 188,
        "Text": "\u4ea4\u95ea\u9e26\u7ffc"
    },
    {
        "Id": 189,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u9732\u897f\u4e9a \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 190,
        "Text": "\u5999\u7b14\u751f\u8679"
    },
    {
        "Id": 191,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u827e\u62c9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 192,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a\u827e\u62c9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 193,
        "Text": "\u544a\u89e3\u5929\u4f7f"
    },
    {
        "Id": 194,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u4e3d\u8299 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 195,
        "Text": "\u661f\u8109\u5f00\u8f9f"
    },
    {
        "Id": 196,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u4e03\u5b9e \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 197,
        "Text": "\u4e0d\u706d\u65d7\u67aa"
    },
    {
        "Id": 198,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8587\u62c9 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 199,
        "Text": "\u53cd\u9006\u9a91\u624b"
    },
    {
        "Id": 200,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u963f\u5c14\u6cd5 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 201,
        "Text": "\u7eaf\u767d\u5e7c\u517d"
    },
    {
        "Id": 202,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014{0}\u53f7"
    },
    {
        "Id": 203,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a 21\u53f7 \u589e\u52a0 20000 \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 204,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a 21\u53f7 \u589e\u52a0 45000 \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 205,
        "Text": "\u9010\u661f\u8005"
    },
    {
        "Id": 206,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u54c8\u5361\u739b"
    },
    {
        "Id": 207,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u54c8\u5361\u739b \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 208,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u54c8\u5361\u739b \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 209,
        "Text": "\u5929\u7a7a\u9738\u4e3b"
    },
    {
        "Id": 210,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u8d5b\u5229\u5361"
    },
    {
        "Id": 211,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8d5b\u5229\u5361 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 212,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8d5b\u5229\u5361 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 213,
        "Text": "\u5feb\u4e50\u9ca8"
    },
    {
        "Id": 214,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u9ca8\u58eb\u78a7\u513f"
    },
    {
        "Id": 215,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u9ca8\u58eb\u78a7\u513f \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 216,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u9ca8\u58eb\u78a7\u513f \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 217,
        "Text": "\u8d64\u7ea2\u730e\u72ac"
    },
    {
        "Id": 218,
        "Text": "\u611f\u8c22\u652f\u63f4\u2014\u2014\u8bfa\u514b\u63d0"
    },
    {
        "Id": 219,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8bfa\u514b\u63d0 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u84dd\u8272"
    },
    {
        "Id": 220,
        "Text": "\u5728\u4f0a\u7538\u6587\u5316\u7eaa\u4e2d\u4e3a \u8bfa\u514b\u63d0 \u589e\u52a0 {0} \u70ed\u5ea6\u503c\u540e\uff0c\u54c1\u8d28\u5347\u5230\u91d1\u8272"
    },
    {
        "Id": 221,
        "Text": "\u5c16\u5175\u90e8\u961f"
    },
    {
        "Id": 222,
        "Text": "\u4e3a\u6d3b\u8dc3\u5728\u6218\u573a\u5404\u5904\uff0c\u653b\u514b\u91cd\u91cd\u9669\u5173\u7684\u6307\u6325\u5b98\u6388\u4e88\u7684\u8363\u8a89\u79f0\u53f7\u3002"
    },
    {
        "Id": 223,
        "Text": "B\u7ea7\u6267\u7167-\u5c16\u5175\u90e8\u961f"
    },
    {
        "Id": 224,
        "Text": "\u7279\u79cd\u7a7a\u52e4"
    },
    {
        "Id": 225,
        "Text": "\u6b64\u9879\u8363\u8a89\u7279\u522b\u6388\u4e88\u5728\u6700\u5371\u9669\u5730\u57df\uff0c\u6267\u884c\u6700\u5371\u9669\u4efb\u52a1\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 226,
        "Text": "A\u7ea7\u6267\u7167-\u7279\u79cd\u7a7a\u52e4"
    },
    {
        "Id": 227,
        "Text": "\u5168\u6218\u4e13\u5bb6"
    },
    {
        "Id": 228,
        "Text": "\u8fd9\u4efd\u8363\u8a89\u4e0d\u4ec5\u662f\u5bf9\u80fd\u529b\u7684\u8d5e\u8d4f\uff0c\u4e5f\u662f\u613f\u610f\u5c06\u4e00\u7247\u6218\u533a\u7684\u5168\u6743\u4e8b\u52a1\u6258\u4ed8\u7684\u4fe1\u4efb\u3002"
    },
    {
        "Id": 229,
        "Text": "S\u7ea7\u6267\u7167-\u5168\u6218\u4e13\u5bb6"
    },
    {
        "Id": 230,
        "Text": "\u6cd5\u5965\u65af\u65b0\u661f"
    },
    {
        "Id": 231,
        "Text": "\u6700\u9ad8\u673a\u5bc6\u4fe1\u606f\uff0c\u6743\u9650\u4e0d\u8db3\u65e0\u6cd5\u8bbf\u95ee\u3002"
    },
    {
        "Id": 232,
        "Text": "X\u7ea7\u6267\u7167-\u6cd5\u5965\u65af\u65b0\u661f"
    },
    {
        "Id": 233,
        "Text": "\u9eef\u5203\u6298\u89d2"
    },
    {
        "Id": 234,
        "Text": "\u5c71\u5cb3\u503e\u8986\uff0c\u9eef\u89d2\u6298\u65ad\u3002\u51fb\u7834\u9eef\u89d2\u6570\u636e\u4f53\u6839\u6e90\u7684\u8363\u8000\u8bc1\u660e\u3002"
    },
    {
        "Id": 235,
        "Text": "\u4e9a\u5361\u6570\u754c-\u9eef\u5203\u6298\u89d2"
    },
    {
        "Id": 236,
        "Text": "\u5b8c\u6210\u4e9a\u5361\u6570\u754c\u4efb\u52a1\u83b7\u5f97"
    },
    {
        "Id": 237,
        "Text": "\u8f89\u77db\u65ad\u5149"
    },
    {
        "Id": 238,
        "Text": "\u4e91\u6d88\u96fe\u6563\uff0c\u8f89\u5149\u6d88\u7109\u3002\u51fb\u7834\u8f89\u5149\u6570\u636e\u4f53\u6839\u6e90\u7684\u8363\u8000\u8bc1\u660e\u3002"
    },
    {
        "Id": 239,
        "Text": "\u4e9a\u5361\u6570\u754c-\u8f89\u77db\u65ad\u5149"
    },
    {
        "Id": 240,
        "Text": "\u6298\u89d2\u65ad\u5149"
    },
    {
        "Id": 241,
        "Text": "\u53cc\u9f99\u67ad\u9996\uff0c\u8fde\u6218\u65e0\u524d\u3002\u8fde\u7eed\u51fb\u7834\u9eef\u89d2\u4e0e\u8f89\u5149\u6570\u636e\u4f53\u6839\u6e90\u7684\u8363\u8000\u8bc1\u660e\u3002"
    },
    {
        "Id": 242,
        "Text": "\u4e9a\u5361\u6570\u754c-\u6298\u89d2\u65ad\u5149"
    },
    {
        "Id": 243,
        "Text": "\u636e\u70b9\u5148\u950b"
    },
    {
        "Id": 244,
        "Text": "\u6b64\u8363\u8a89\u5c06\u6388\u4e88\u4e3a\u91cd\u8fd4\u5bb6\u56ed\u800c\u5728\u636e\u70b9\u95f4\u594b\u6218\u7684\u6307\u6325\u5b98\uff0c\u6587\u660e\u4e4b\u706b\u56e0\u4f60\u4eec\u5f97\u4ee5\u5b58\u7eed\u3002"
    },
    {
        "Id": 245,
        "Text": "\u901a\u8fc7\u636e\u70b9\u73a9\u6cd5\u83b7\u5f97"
    },
    {
        "Id": 246,
        "Text": "\u7070\u7fbd\u663c\u7ffc"
    },
    {
        "Id": 247,
        "Text": "\u6210\u4e3a\u7fc5\u8180\uff0c\u6210\u4e3a\u7fbd\u7ffc\uff0c\u4e0d\u79bb\u4e0d\u5f03\u3002"
    },
    {
        "Id": 248,
        "Text": "\u7d2f\u8ba1\u8d2d\u4e70{0}\u8679\u5361\u53ef\u83b7\u5f97"
    },
    {
        "Id": 249,
        "Text": "\u6df1\u7ea2\u56da\u5f71\u00b7\u6b8b\u9e23"
    },
    {
        "Id": 250,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u6df1\u7ea2\u56da\u5f71\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 251,
        "Text": "\u901a\u8fc7\u62df\u50cf\u8bd5\u70bc\u73a9\u6cd5\u83b7\u5f97"
    },
    {
        "Id": 252,
        "Text": "\u5f02\u706b\u00b7\u707c\u70bc"
    },
    {
        "Id": 253,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u5f02\u706b\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 254,
        "Text": "\u7eef\u8000\u00b7\u8f89\u9706"
    },
    {
        "Id": 255,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u7eef\u8000\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 256,
        "Text": "\u6a80\u5fc3\u00b7\u7fe9\u4e91"
    },
    {
        "Id": 257,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u6a80\u5fc3\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 258,
        "Text": "\u8a93\u7130\u00b7\u7834\u8327"
    },
    {
        "Id": 259,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u8a93\u7130\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 260,
        "Text": "\u8292\u661f\u4e4b\u8ff9\u00b7\u66e6\u5149"
    },
    {
        "Id": 261,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u8292\u661f\u4e4b\u8ff9\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 262,
        "Text": "\u5e0c\u58f0\u00b7\u6eaf\u4e50"
    },
    {
        "Id": 263,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u5e0c\u58f0\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 264,
        "Text": "\u7ef4\u5409\u5c14\u00b7Sin Devil"
    },
    {
        "Id": 265,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u7ef4\u5409\u5c14\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 266,
        "Text": "\u4f46\u4e01\u00b7Sin Devil"
    },
    {
        "Id": 267,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u4f46\u4e01\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 268,
        "Text": "\u707c\u60d8\u00b7\u5384\u70ec"
    },
    {
        "Id": 269,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u707c\u60d8\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 270,
        "Text": "\u5730\u72f1\u9a91\u58eb"
    },
    {
        "Id": 271,
        "Text": "\u201c\u6211\u770b\u89c1\u4e00\u5339\u767d\u9a6c\uff0c\u5730\u72f1\u7d27\u968f\u5176\u540e\u3002\u201d"
    },
    {
        "Id": 272,
        "Text": "\u53c2\u4e0e\u795e\u5bc2\u542f\u793a\u5f55-\u4ea1\u547d\u6b7b\u7ade\uff0c\u8fbe\u5230\u6307\u5b9a\u6bb5\u4f4d\u540e\u83b7\u5f97"
    },
    {
        "Id": 273,
        "Text": "\u6076\u9b54\u9886\u4e3b"
    },
    {
        "Id": 274,
        "Text": "\u72c2\u4e71\u800c\u5e7d\u9083\u7684\u5730\u72f1\u4e4b\u4e2d\uff0c\u603b\u4f1a\u6709\u96f6\u661f\u7684\u6076\u9b54\u4ece\u5c38\u5c71\u8840\u6d77\u4e2d\u6740\u51fa\uff0c\u7ee7\u627f\u6b7b\u4ea1\u5927\u541b\u6743\u67c4\uff0c\u88ab\u6388\u4ee5\u9886\u4e3b\u7684\u5934\u8854\u3002"
    },
    {
        "Id": 275,
        "Text": "\u795e\u5bc2\u5929\u542f"
    },
    {
        "Id": 276,
        "Text": "\u4e0d\u613f\u5728\u5723\u5802\u4e3a\u5974\uff0c\u53ea\u613f\u5728\u5730\u72f1\u79f0\u738b\u3002"
    },
    {
        "Id": 277,
        "Text": "\u70bc\u72f1\u9a81\u9a91"
    },
    {
        "Id": 278,
        "Text": "\u201c\u51b2\u51fa\u8fd9\u65e0\u5c3d\u7684\u56de\u5eca\uff0c\u6211\u4ece\u4e0d\u53d7\u547d\u8fd0\u7981\u9522\u3002\u201d"
    },
    {
        "Id": 279,
        "Text": "\u6076\u9b3c\u4e4b\u738b"
    },
    {
        "Id": 280,
        "Text": "\u4e00\u5207\u7684\u8d22\u5bcc\u548c\u91ce\u5fc3\uff0c\u5747\u8981\u81e3\u670d\u5728\u6211\u7684\u6b32\u5ff5\u4e4b\u4e0b\u3002"
    },
    {
        "Id": 281,
        "Text": "\u70ec\u571f\u4e3b\u5bb0"
    },
    {
        "Id": 282,
        "Text": "\u8c01\u8bf4\u81f3\u9ad8\u5929\u5b9a\u4e0b\u7684\u5f8b\u6cd5\u7262\u4e0d\u53ef\u7834\uff1f\u5c31\u7531\u6211\u6765\u8ba9\u90a3\u6c38\u6052\u767d\u663c\u53d8\u4f5c\u65e0\u68a6\u7684\u957f\u591c\u3002"
    },
    {
        "Id": 283,
        "Text": "\u738b\u724c\u8f66\u624b"
    },
    {
        "Id": 284,
        "Text": "\u4e3a\u53c2\u4e0e\u661f\u95f4\u98de\u9a70\u7ade\u901f\u9884\u6d4b\u7684\u6307\u6325\u5b98\u4eec\u9881\u53d1\u7684\u7279\u522b\u8363\u8a89\u3002\u8bf7\u5c3d\u60c5\u4eab\u53d7\u8fd9\u573a\u5f15\u7206\u80be\u4e0a\u817a\u7d20\u7684\u72c2\u98d9\u76db\u5bb4\u5427\u3002"
    },
    {
        "Id": 285,
        "Text": "\u53c2\u4e0e\u661f\u95f4\u98de\u9a70\uff0c\u5728\u6781\u901f\u6d3e\u5bf9\u5185\u5151\u6362\u83b7\u5f97"
    },
    {
        "Id": 286,
        "Text": "\u6c38\u591c\u541b\u4e3b"
    },
    {
        "Id": 287,
        "Text": "\u5728\u795e\u660e\u5bc2\u706d\u540e\u7684\u4e16\u754c\uff0c\u9b54\u541b\u4ecd\u5b58\u3002"
    },
    {
        "Id": 288,
        "Text": "\u6536\u96c6\u300c\u79c1\u88c1\u00b7\u795e\u5bc2\u542f\u793a\u5f55\u300d\u7cfb\u5217\u5168\u90e8\u6d82\u88c5\u540e\u83b7\u5f97"
    },
    {
        "Id": 289,
        "Text": "\u8da3\u95fb\u63a2\u7d22\u8005"
    },
    {
        "Id": 290,
        "Text": "\u4ece\u77e5\u6167\u6e38\u5eca\u59cb\u6b65\uff0c\u884c\u81f3\u7199\u6518\u7684\u6e2f\u53e3\uff0c\u904d\u5386\u5176\u95f4\u9038\u95fb\u8da3\u4e8b\u7684\u63a2\u7d22\u8005\u4e4b\u8bc1\u3002"
    },
    {
        "Id": 291,
        "Text": "\u5b8c\u6210\u7a7a\u4e2d\u82b1\u56ed\u300c\u884c\u52a8\u6307\u5357\u2161\u300d\u4efb\u52a1\u6e05\u5355\u83b7\u53d6"
    },
    {
        "Id": 292,
        "Text": "\u6b32\u5ff5\u88c1\u6267"
    },
    {
        "Id": 293,
        "Text": "\u73b0\u5728\uff0c\u7531\u6211\u6765\u4e3a\u4e16\u95f4\u4e00\u5207\u6b32\u671b\u79f0\u91cd\u3001\u5b9a\u4ef7\u3002"
    },
    {
        "Id": 294,
        "Text": "\u6d41\u91d1\u4e4b\u8680"
    },
    {
        "Id": 295,
        "Text": "\u770b\u5450\uff0c\u5c31\u8fde\u90a3\u9ec4\u91d1\u7684\u6d2a\u6d41\u4e5f\u5728\u6b64\u523b\u4e3a\u6211\u51dd\u56fa\uff0c\u65cb\u5373\u4fbf\u88ab\u541e\u5165\u8179\u4e2d\u3002"
    },
    {
        "Id": 296,
        "Text": "\u7ec8\u4e34\u5929\u542f"
    },
    {
        "Id": 297,
        "Text": "\u5723\u949f\u54cd\u5f7b\u81f3\u9ad8\u5929\uff0c\u88c1\u51b3\u7684\u5929\u79e4\u5df2\u7136\u5c31\u4f4d\u3002\u4f46\u8fd9\u4e00\u6b21\uff0c\u88ab\u63a8\u4e0a\u5ba1\u5224\u5e2d\u7684\uff0c\u5c06\u662f\u795e\u660e\u81ea\u8eab\u3002"
    },
    {
        "Id": 298,
        "Text": "\u8d85\u94fe\u884c\u8005"
    },
    {
        "Id": 299,
        "Text": "\u4e8e\u6570\u636e\u7684\u6d2a\u6d41\u4e2d\uff0c\u5e76\u80a9\u540c\u884c\uff0c\u5171\u6321\u950b\u9510\u3002"
    },
    {
        "Id": 300,
        "Text": "\u53c2\u4e0e\u8d85\u94fe\u534f\u9635\u73a9\u6cd5\uff0c\u5b8c\u6210\u4efb\u52a1\u53ef\u83b7\u5f97\u3002"
    },
    {
        "Id": 301,
        "Text": "\u65e0\u68a6\u9b54\u5973"
    },
    {
        "Id": 302,
        "Text": "\u4ece\u4eca\u4ee5\u540e\uff0c\u4f60\u7684\u6bcf\u4e00\u4e2a\u7f8e\u68a6\u548c\u5669\u68a6\u91cc\u9762\u90fd\u4f1a\u6709\u6211\u7684\u8eab\u5f71\u3002"
    },
    {
        "Id": 303,
        "Text": "\u8ba3\u544a\u6e21\u9e26"
    },
    {
        "Id": 304,
        "Text": "\u5728\u6b64\u5ba3\u544a\uff0c\u6b7b\u4ea1\u7684\u964d\u4e34\u3002"
    },
    {
        "Id": 305,
        "Text": "\u6c34\u4ed9\u4e4b\u5fc3"
    },
    {
        "Id": 306,
        "Text": "\u4f60\u7ed9\u4e88\u6211\u4f60\u7684\u5fc3\uff0c\u6211\u4ea4\u4e88\u4f60\u6574\u4e2a\u4e16\u754c\u7684\u547d\u8fd0\u3002"
    },
    {
        "Id": 307,
        "Text": "\u6df1\u7ea2\u4e4b\u6e0a\u00b7\u65ad\u5bc2"
    },
    {
        "Id": 308,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u6df1\u7ea2\u4e4b\u6e0a\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 309,
        "Text": "\u9006\u5195\u00b7\u5239\u591c"
    },
    {
        "Id": 310,
        "Text": "\u6b64\u94ed\u724c\u7528\u4ee5\u8868\u5f70\u5728\u3010\u62df\u50cf\u8bd5\u70bc\u3011\u6d3b\u52a8\u4e2d\u4f7f\u7528\u9006\u5195\u673a\u4f53\u8fbe\u6210\u76ee\u6807\u7684\u6307\u6325\u5b98\u3002"
    },
    {
        "Id": 311,
        "Text": "\u6f84\u6d77\u6674\u5149"
    },
    {
        "Id": 312,
        "Text": "\u613f\u8fd9\u4e2a\u7f8e\u597d\u7684\u590f\u65e5\uff0c\u6c38\u8fdc\u4e0d\u8981\u7ed3\u675f\u3002"
    },
    {
        "Id": 313,
        "Text": "\u6536\u96c6\u300c\u79c1\u88c1\u00b7\u6c50\u843d\u6d6e\u5149\u300d\u7cfb\u5217\u5168\u90e8\u6d82\u88c5\u540e\u83b7\u5f97"
    }
]